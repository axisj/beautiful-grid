---
import { productFacts } from '../../data/productFacts';
import { localizePath, normalizeLocale, type Locale } from '../../i18n';

interface Props { locale?: Locale; adaptiveLocale?: boolean; }
const locale = normalizeLocale(Astro.props.locale);
const adaptiveLocale = Astro.props.adaptiveLocale ?? false;
const currentYear = new Date().getFullYear();
const copy = locale === 'ko' ? {
  axisjLabel: 'AXISJ.com 방문',
  intro: 'AXISJ가 만드는 BeautifulGrid.',
  description: 'React 업무 화면에서 복잡한 데이터를 빠르게 탐색하고 편집하는 TypeScript 데이터 그리드 프로젝트입니다.',
  product: 'Product', developers: 'Developers', projects: 'AXISJ Projects',
  learn: '가이드 & 예제', adoption: '도입 안내', review: '환경 안내 검토일',
} : {
  axisjLabel: 'Visit AXISJ.com',
  intro: 'BeautifulGrid, built by AXISJ.',
  description: 'A TypeScript DataGrid project for navigating and editing complex data in React business applications.',
  product: 'Product', developers: 'Developers', projects: 'AXISJ Projects',
  learn: 'Learn & Examples', adoption: 'Product Facts', review: 'Product facts reviewed',
};
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="https://axisj.com" class="footer-logo" target="_blank" rel="noopener noreferrer" aria-label={copy.axisjLabel}>
        <img src="/axisj-wordmark.svg" alt="AXISJ" width="100" height="24" />
      </a>
      <p><strong data-footer-copy="intro" data-ko="AXISJ가 만드는 BeautifulGrid." data-en="BeautifulGrid, built by AXISJ.">{copy.intro}</strong><br /><span data-footer-copy="description" data-ko="React 업무 화면에서 복잡한 데이터를 빠르게 탐색하고 편집하는 TypeScript 데이터 그리드 프로젝트입니다." data-en="A TypeScript DataGrid project for navigating and editing complex data in React business applications.">{copy.description}</span></p>
      <div class="package-meta"><span>React</span><span>TypeScript</span><span>DOM</span></div>
    </div>
    <div class="footer-links">
      <div class="link-column">
        <h2>{copy.product}</h2>
        <a href={localizePath('/learn', locale)} data-footer-route="/learn" data-footer-copy="learn" data-ko="가이드 & 예제" data-en="Learn & Examples">{copy.learn}</a>
        <a href={localizePath('/playground', locale)} data-footer-route="/playground">Playground</a>
        <a href={localizePath('/product-facts', locale)} data-footer-route="/product-facts" data-footer-copy="adoption" data-ko="도입 안내" data-en="Product Facts">{copy.adoption}</a>
      </div>
      <div class="link-column">
        <h2>{copy.developers}</h2>
        <a href={localizePath('/learn/getting-started', locale)} data-footer-route="/learn/getting-started">Getting Started</a>
        <a href={localizePath('/api/props', locale)} data-footer-route="/api/props">API</a>
        <a href={localizePath('/open-source', locale)} data-footer-route="/open-source">Open Source</a>
        <a href={productFacts.npmUrl} target="_blank" rel="noopener noreferrer">npm ↗</a>
        <a href={productFacts.repositoryUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
      <div class="link-column">
        <h2>{copy.projects}</h2>
        <a href="https://axisj.com" target="_blank" rel="noopener noreferrer">AXISJ.com ↗</a>
        <a href="https://manualtalk.axisj.com" target="_blank" rel="noopener noreferrer">ManualTalk ↗</a>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {currentYear} AXISJ · Open source under Apache-2.0</p>
    <a href={localizePath('/product-facts', locale)} data-footer-route="/product-facts">v{productFacts.version} · <span data-footer-copy="review" data-ko="환경 안내 검토일" data-en="Product facts reviewed">{copy.review}</span> {productFacts.lastReviewedAt}</a>
  </div>
</footer>

{adaptiveLocale && (
  <script is:inline>
    const footerLocale = window.location.pathname === '/en' || window.location.pathname.startsWith('/en/') ? 'en' : 'ko';
    const localizeFooterPath = (path) => footerLocale === 'en' ? `/en${path === '/' ? '/' : path}` : path;
    document.querySelectorAll('[data-footer-copy]').forEach((element) => {
      element.textContent = element.dataset[footerLocale] || element.textContent;
    });
    document.querySelectorAll('[data-footer-route]').forEach((link) => {
      link.href = localizeFooterPath(link.dataset.footerRoute);
    });
  </script>
)}

<style>
  .site-footer { border-top: 1px solid var(--site-border); padding: 62px 0 24px; background: linear-gradient(color-mix(in srgb, var(--site-accent) 4%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--site-accent) 4%, transparent) 1px, transparent 1px), var(--site-surface); background-size: 38px 38px; }
  .footer-inner { display: grid; grid-template-columns: minmax(280px, 1.2fr) minmax(440px, 0.8fr); gap: 80px; }
  .footer-brand { max-width: 440px; }
  .footer-logo { display: inline-flex; align-items: center; color: var(--site-text-primary); }
  .footer-logo:hover { text-decoration: none; }
  .footer-logo img { display: block; width: 88px; height: auto; }
  :global(html[data-theme='dark']) .footer-logo img { filter: brightness(0) invert(1); }
  .footer-brand p { margin: 16px 0 20px; color: var(--site-text-secondary); font-size: 13px; line-height: 1.8; word-break: keep-all; }
  .footer-brand strong { color: var(--site-text-primary); }
  .package-meta { display: flex; flex-wrap: wrap; gap: 7px; }
  .package-meta span { border: 1px solid var(--site-border); border-radius: 999px; padding: 3px 8px; background: var(--site-overlay-bg); color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 9px; font-weight: 700; }
  .footer-links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 38px; }
  .link-column { display: flex; flex-direction: column; gap: 9px; }
  .link-column h2 { margin: 0 0 6px; color: var(--site-text-primary); font-size: 11px; font-weight: 850; letter-spacing: 0.08em; text-transform: uppercase; }
  .link-column a { color: var(--site-text-secondary); font-size: 12px; font-weight: 600; }
  .link-column a:hover { color: var(--site-accent-strong); }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 54px; border-top: 1px solid var(--site-border); padding-top: 20px; color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 9px; }
  .footer-bottom p { margin: 0; }
  .footer-bottom a { color: inherit; }
  @media (max-width: 820px) { .footer-inner { grid-template-columns: 1fr; gap: 42px; } .footer-brand { max-width: 560px; } }
  @media (max-width: 560px) { .site-footer { padding-top: 48px; } .footer-links { grid-template-columns: repeat(2, 1fr); row-gap: 34px; } .footer-bottom { align-items: flex-start; flex-direction: column; } }
</style>
