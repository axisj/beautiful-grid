---
import { GitFork } from 'lucide-react';
import { productFacts } from '../../data/productFacts';
import { commonMessages, localizePath, normalizeLocale, type Locale } from '../../i18n';
import SitePreferences from './SitePreferences.astro';

interface Props { locale?: Locale; adaptiveLocale?: boolean; }

const locale = normalizeLocale(Astro.props.locale);
const adaptiveLocale = Astro.props.adaptiveLocale ?? false;
const messages = commonMessages[locale];
const navigation = [
  { label: messages.guideExamples, koLabel: commonMessages.ko.guideExamples, enLabel: commonMessages.en.guideExamples, href: localizePath('/learn', locale), route: '/learn', external: false },
  { label: 'API', koLabel: 'API', enLabel: 'API', href: localizePath('/api/props', locale), route: '/api/props', external: false },
  { label: messages.adoptionGuide, koLabel: commonMessages.ko.adoptionGuide, enLabel: commonMessages.en.adoptionGuide, href: localizePath('/product-facts', locale), route: '/product-facts', external: false },
  { label: messages.openSource, koLabel: commonMessages.ko.openSource, enLabel: commonMessages.en.openSource, href: localizePath('/open-source', locale), route: '/open-source', external: false },
  { label: 'Playground', koLabel: 'Playground', enLabel: 'Playground', href: localizePath('/playground', locale), route: '/playground', external: false },
  { label: messages.github, koLabel: commonMessages.ko.github, enLabel: commonMessages.en.github, href: productFacts.repositoryUrl, route: '', external: true },
];
---
<header class="site-header">
  <div class="container header-inner">
    <a href={localizePath('/', locale)} class="brand" aria-label={`BeautifulGrid ${messages.home}`} data-shell-home>
      <span class="brand-lockup" aria-hidden="true">
        <svg
          class="brand-symbol"
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="24"
          viewBox="0 0 36 24"
          focusable="false"
        >
          <path d="M18.7 20.8c-.9 0-1.6-.7-1.6-1.6s.7-1.6 1.6-1.6c3.1 0 5.6-2.5 5.6-5.6s-2.5-5.6-5.6-5.6c-.9 0-1.6-.7-1.6-1.6s.7-1.6 1.6-1.6c4.8 0 8.8 3.9 8.8 8.8s-4 8.8-8.8 8.8" fill="#78b9f3" />
          <path d="M18.7 20.8h-7.8c-.9 0-1.6-.7-1.6-1.6s.7-1.6 1.6-1.6h7.8c.9 0 1.6.7 1.6 1.6s-.8 1.6-1.6 1.6" fill="#78b9f3" />
          <linearGradient id="site-logo-symbol-gradient" x1="20.415" x2="1.355" y1="12" y2="12" gradientUnits="userSpaceOnUse">
            <stop offset="0.511" stop-color="#78b9f3" />
            <stop offset="1" stop-color="#3256de" />
          </linearGradient>
          <path d="M3 20.8c-.3 0-.5-.1-.7-.2-.8-.4-1.1-1.4-.7-2.2L9 4.1c.3-.5.8-.8 1.4-.9.6 0 1.1.3 1.4.8l8.3 14.4c.4.8.2 1.7-.6 2.2-.8.4-1.7.2-2.2-.6L10.5 8.1 4.4 19.9c-.3.6-.9.9-1.4.9" fill="url(#site-logo-symbol-gradient)" />
          <path d="M33 20.8c-4.8 0-8.8-3.9-8.8-8.8s3.9-8.8 8.8-8.8c.9 0 1.6.7 1.6 1.6s-.7 1.6-1.6 1.6c-3.1 0-5.6 2.5-5.6 5.6s2.5 5.6 5.6 5.6c.9 0 1.6.7 1.6 1.6s-.7 1.6-1.6 1.6" fill="#3256de" />
        </svg>
        <span class="brand-name">Beautiful<span>Grid</span></span>
      </span>
      <span class="version-badge">v{productFacts.version}</span>
    </a>

    <nav class="primary-nav desktop-only" aria-label={messages.primaryNavigation} data-shell-navigation="primary">
      {navigation.map(item => (
        <a href={item.href} data-shell-route={item.route || undefined} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
          <span class="nav-label">
            {item.external && <GitFork className="github-icon" size={15} strokeWidth={2.2} aria-hidden="true" />}
            <span data-shell-label data-ko={item.koLabel} data-en={item.enLabel}>{item.label}</span>
          </span>
          {item.external && <span aria-hidden="true">↗</span>}
        </a>
      ))}
    </nav>

    <div class="header-actions">
       <div class="desktop-preferences"><SitePreferences locale={locale} idPrefix="desktop" adaptiveLocale={adaptiveLocale} /></div>
      <button class="mobile-menu-btn" type="button" aria-label={messages.openMenu} aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

   <nav id="mobile-nav" class="mobile-nav" aria-label={messages.mobileNavigation} data-shell-navigation="mobile" hidden>
    <div class="container mobile-nav-inner">
       <div class="mobile-preferences"><SitePreferences locale={locale} idPrefix="mobile" compact adaptiveLocale={adaptiveLocale} /></div>
      {navigation.map(item => (
         <a href={item.href} data-shell-route={item.route || undefined} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}>
          <span class="nav-label">
            {item.external && <GitFork className="github-icon" size={15} strokeWidth={2.2} aria-hidden="true" />}
             <span data-shell-label data-ko={item.koLabel} data-en={item.enLabel}>{item.label}</span>
          </span>
          <span aria-hidden="true">{item.external ? '↗' : '→'}</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid color-mix(in srgb, var(--site-border) 84%, transparent); background: color-mix(in srgb, var(--site-page-bg) 88%, transparent); box-shadow: 0 10px 30px -32px rgba(15, 23, 42, 0.75); backdrop-filter: saturate(160%) blur(16px); }
  .header-inner { display: grid; grid-template-columns: 1fr auto 1fr; min-height: 68px; align-items: center; gap: 22px; }
  .brand { display: inline-flex; width: max-content; align-items: center; gap: 10px; color: var(--site-text-primary); text-decoration: none; }
  .brand-lockup { display: inline-flex; align-items: center; gap: 9px; }
  .brand:hover, .primary-nav a:hover, .mobile-nav a:hover { text-decoration: none; }
  .brand-symbol { display: block; width: 36px; height: 24px; flex: 0 0 auto; }
  .brand-name { color: var(--site-text-primary); font-size: 19px; font-weight: 800; line-height: 1; letter-spacing: -0.03em; }
  .brand-name span { color: var(--site-accent-strong); }
  .version-badge { border: 1px solid var(--site-border); border-radius: 999px; padding: 2px 6px; background: var(--site-surface); color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; font-weight: 700; }
  .primary-nav { display: flex; align-items: center; gap: 21px; }
  .primary-nav a { display: inline-flex; align-items: center; gap: 4px; color: var(--site-text-secondary); font-size: 13px; font-weight: 700; transition: color 150ms ease; white-space: nowrap; }
  .nav-label { display: inline-flex; align-items: center; gap: 6px; }
  :global(.github-icon) { display: block; width: 15px; height: 15px; flex: 0 0 auto; }
  .primary-nav a:hover { color: var(--site-accent-strong); }
  .header-actions { display: flex; align-items: center; justify-content: flex-end; }
  .mobile-menu-btn { display: none; width: 40px; height: 40px; border: 1px solid var(--site-border); border-radius: 10px; padding: 9px; background: var(--site-control-bg); color: var(--site-text-primary); cursor: pointer; }
  .mobile-menu-btn span { display: block; width: 100%; height: 2px; margin: 3px 0; border-radius: 2px; background: currentColor; transition: transform 150ms ease, opacity 150ms ease; }
  .mobile-menu-btn[aria-expanded='true'] span:first-child { transform: translateY(5px) rotate(45deg); }
  .mobile-menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn[aria-expanded='true'] span:last-child { transform: translateY(-5px) rotate(-45deg); }
  .mobile-nav { border-top: 1px solid var(--site-border); background: var(--site-overlay-bg); }
  .mobile-nav-inner { display: grid; padding-top: 10px; padding-bottom: 14px; }
  .mobile-preferences { margin-bottom: 8px; padding-bottom: 10px; border-bottom: 1px solid var(--site-border); }
  .mobile-nav a:not(.preference-button) { display: flex; min-height: 44px; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--site-border); color: var(--site-text-secondary); font-size: 14px; font-weight: 700; }
  @media (max-width: 1080px) { .primary-nav { gap: 15px; } .header-inner { gap: 14px; } }
  @media (max-width: 960px) { .header-inner { display: flex; justify-content: space-between; } .desktop-only, .desktop-preferences { display: none; } .mobile-menu-btn { display: block; } }
  @media (max-width: 420px) { .brand { gap: 7px; } .brand-lockup { gap: 7px; } .brand-symbol { width: 36px; height: 24px; } .brand-name { font-size: 17px; } .version-badge { display: none; } }
</style>

<script is:inline define:vars={{
  adaptiveLocale,
  openLabel: messages.openMenu,
  closeLabel: messages.closeMenu,
  koPrimaryNavigation: commonMessages.ko.primaryNavigation,
  enPrimaryNavigation: commonMessages.en.primaryNavigation,
  koMobileNavigation: commonMessages.ko.mobileNavigation,
  enMobileNavigation: commonMessages.en.mobileNavigation,
  koOpenMenu: commonMessages.ko.openMenu,
  enOpenMenu: commonMessages.en.openMenu,
  koCloseMenu: commonMessages.ko.closeMenu,
  enCloseMenu: commonMessages.en.closeMenu,
}}>
  const shellLocale = adaptiveLocale && (window.location.pathname === '/en' || window.location.pathname.startsWith('/en/')) ? 'en' : document.documentElement.lang === 'en' ? 'en' : 'ko';
  const activeOpenLabel = shellLocale === 'en' ? enOpenMenu : koOpenMenu;
  const activeCloseLabel = shellLocale === 'en' ? enCloseMenu : koCloseMenu;
  if (adaptiveLocale) {
    const localizeShellPath = (path) => shellLocale === 'en' ? `/en${path === '/' ? '/' : path}` : path;
    document.querySelectorAll('[data-shell-label]').forEach((label) => { label.textContent = label.dataset[shellLocale] || label.textContent; });
    document.querySelectorAll('[data-shell-route]').forEach((link) => { link.href = localizeShellPath(link.dataset.shellRoute); });
    const home = document.querySelector('[data-shell-home]');
    if (home) { home.href = localizeShellPath('/'); home.setAttribute('aria-label', shellLocale === 'en' ? 'BeautifulGrid Home' : 'BeautifulGrid 홈'); }
    document.querySelector('[data-shell-navigation="primary"]')?.setAttribute('aria-label', shellLocale === 'en' ? enPrimaryNavigation : koPrimaryNavigation);
    document.querySelector('[data-shell-navigation="mobile"]')?.setAttribute('aria-label', shellLocale === 'en' ? enMobileNavigation : koMobileNavigation);
  }
  const button = document.querySelector('.mobile-menu-btn');
  const navigation = document.getElementById('mobile-nav');
  const closeNavigation = (returnFocus = false) => {
    if (!button || !navigation) return;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', adaptiveLocale ? activeOpenLabel : openLabel);
    navigation.hidden = true;
    if (returnFocus) button.focus();
  };
  button?.addEventListener('click', () => {
    if (!navigation) return;
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    button.setAttribute('aria-label', expanded ? (adaptiveLocale ? activeOpenLabel : openLabel) : (adaptiveLocale ? activeCloseLabel : closeLabel));
    navigation.hidden = expanded;
  });
  navigation?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeNavigation(true);
  });
  window.matchMedia('(min-width: 961px)').addEventListener('change', (event) => {
    if (event.matches) closeNavigation();
  });
</script>
