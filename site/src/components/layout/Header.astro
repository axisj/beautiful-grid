---
import { getCollection } from 'astro:content';
import { productFacts } from '../../data/productFacts';
import { commonMessages, localizePath, normalizeLocale, type Locale } from '../../i18n';
import { groupLearnArticles, learnPath } from '../learn/learnLocale';
import SitePreferences from './SitePreferences.astro';
import MobileNavigationDrawer from './MobileNavigationDrawer.astro';

interface Props { locale?: Locale; adaptiveLocale?: boolean; }

const locale = normalizeLocale(Astro.props.locale);
const adaptiveLocale = Astro.props.adaptiveLocale ?? false;
const messages = commonMessages[locale];
const pathname = Astro.url.pathname;
const checkActive = (route: string) => {
  if (!route) return false;
  if (route === '/learn') {
    return (
      pathname === '/learn' ||
      pathname.startsWith('/learn/') ||
      pathname === '/en/learn' ||
      pathname.startsWith('/en/learn/') ||
      pathname.startsWith('/examples/') ||
      pathname.startsWith('/demo/') ||
      pathname.startsWith('/docs/')
    );
  }
  if (route === '/api/props') {
    return (
      pathname === '/api/props' ||
      pathname.startsWith('/api/') ||
      pathname === '/en/api/props' ||
      pathname.startsWith('/en/api/')
    );
  }
  if (route === '/product-facts') {
    return pathname === localizePath('/product-facts', locale) || pathname === localizePath('/performance', locale);
  }
  const localized = localizePath(route, locale);
  return pathname === localized || pathname.startsWith(`${localized}/`);
};

const navigation = [
  { label: messages.guideExamples, koLabel: commonMessages.ko.guideExamples, enLabel: commonMessages.en.guideExamples, href: localizePath('/learn', locale), route: '/learn', external: false },
  { label: 'API', koLabel: 'API', enLabel: 'API', href: localizePath('/api/props', locale), route: '/api/props', external: false },
  { label: messages.adoptionGuide, koLabel: commonMessages.ko.adoptionGuide, enLabel: commonMessages.en.adoptionGuide, href: localizePath('/product-facts', locale), route: '/product-facts', external: false },
  { label: messages.openSource, koLabel: commonMessages.ko.openSource, enLabel: commonMessages.en.openSource, href: localizePath('/open-source', locale), route: '/open-source', external: false },
  { label: 'Playground', koLabel: 'Playground', enLabel: 'Playground', href: localizePath('/playground', locale), route: '/playground', external: false },
];

const seenDemoIds = new Set<string>();
const runnableLearn = (await getCollection('learn')).filter((item) => {
  if (item.data.locale !== locale || item.data.draft || !item.data.demoId || seenDemoIds.has(item.data.demoId)) {
    return false;
  }
  seenDemoIds.add(item.data.demoId);
  return true;
});
const groupedRunnableLearn = groupLearnArticles(runnableLearn, locale);
const runnableExampleCount = runnableLearn.length;
---
<header class="site-header">
  <div class="container header-inner">
    <a href={localizePath('/', locale)} class="brand" aria-label={`BeautifulGrid ${messages.home}`} data-shell-home>
      <span class="brand-lockup" aria-hidden="true">
        <svg
          class="brand-symbol"
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="24"
          viewBox="0 0 36 24"
          focusable="false"
        >
          <path d="M18.7 20.8c-.9 0-1.6-.7-1.6-1.6s.7-1.6 1.6-1.6c3.1 0 5.6-2.5 5.6-5.6s-2.5-5.6-5.6-5.6c-.9 0-1.6-.7-1.6-1.6s.7-1.6 1.6-1.6c4.8 0 8.8 3.9 8.8 8.8s-4 8.8-8.8 8.8" fill="#78b9f3" />
          <path d="M18.7 20.8h-7.8c-.9 0-1.6-.7-1.6-1.6s.7-1.6 1.6-1.6h7.8c.9 0 1.6.7 1.6 1.6s-.8 1.6-1.6 1.6" fill="#78b9f3" />
          <linearGradient id="site-logo-symbol-gradient" x1="20.415" x2="1.355" y1="12" y2="12" gradientUnits="userSpaceOnUse">
            <stop offset="0.511" stop-color="#78b9f3" />
            <stop offset="1" stop-color="#3256de" />
          </linearGradient>
          <path d="M3 20.8c-.3 0-.5-.1-.7-.2-.8-.4-1.1-1.4-.7-2.2L9 4.1c.3-.5.8-.8 1.4-.9.6 0 1.1.3 1.4.8l8.3 14.4c.4.8.2 1.7-.6 2.2-.8.4-1.7.2-2.2-.6L10.5 8.1 4.4 19.9c-.3.6-.9.9-1.4.9" fill="url(#site-logo-symbol-gradient)" />
          <path d="M33 20.8c-4.8 0-8.8-3.9-8.8-8.8s3.9-8.8 8.8-8.8c.9 0 1.6.7 1.6 1.6s-.7 1.6-1.6 1.6c-3.1 0-5.6 2.5-5.6 5.6s2.5 5.6 5.6 5.6c.9 0 1.6.7 1.6 1.6s-.7 1.6-1.6 1.6" fill="#3256de" />
        </svg>
        <span class="brand-name">Beautiful<span>Grid</span></span>
      </span>
      <span class="version-badge">v{productFacts.version}</span>
    </a>

    <nav class="primary-nav desktop-only" aria-label={messages.primaryNavigation} data-shell-navigation="primary">
      {navigation.map(item => {
        const isActive = !item.external && checkActive(item.route);
        if (item.route === '/learn') {
          return (
            <div class="learn-nav-menu" data-learn-nav-menu>
              <a
                href={item.href}
                class:list={['nav-item', 'learn-nav-trigger', { active: isActive }]}
                data-shell-route={item.route}
                aria-current={isActive ? 'page' : undefined}
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="learn-nav-popover"
              >
                <span class="nav-label">
                  <span data-shell-label data-ko={item.koLabel} data-en={item.enLabel}>{item.label}</span>
                </span>
                <svg class="learn-nav-caret" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
                  <path d="m2.5 4.5 3.5 3 3.5-3" />
                </svg>
              </a>

              <div
                id="learn-nav-popover"
                class="learn-nav-popover"
                aria-label={locale === 'ko' ? '실행 예제 바로가기' : 'Runnable example shortcuts'}
                aria-hidden="true"
                data-learn-nav-popover
              >
                <div class="learn-popover-head">
                  <div>
                    <strong>{locale === 'ko' ? `실행 예제 ${runnableExampleCount}개` : `${runnableExampleCount} runnable examples`}</strong>
                    <span>{locale === 'ko' ? '원하는 기능의 가이드와 예제로 바로 이동하세요.' : 'Jump directly to the guide and example you need.'}</span>
                  </div>
                  <a href={localizePath('/learn', locale)} class="learn-popover-all">
                    {locale === 'ko' ? '전체 가이드 보기' : 'View all guides'} <span aria-hidden="true">→</span>
                  </a>
                </div>

                <div class="learn-popover-grid">
                  {groupedRunnableLearn.map((group) => (
                    <section class="learn-popover-group">
                      <h2>{group.label}</h2>
                      <ul>
                        {group.items.map((learnItem) => (
                          <li>
                            <a href={learnPath(learnItem.slug, locale)}>
                              <span>{locale === 'ko' ? (learnItem.titleKo || learnItem.title) : (learnItem.titleEn || learnItem.title)}</span>
                              <i aria-hidden="true">↗</i>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </section>
                  ))}
                </div>
              </div>
            </div>
          );
        }
        return (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive }]}
            data-shell-route={item.route || undefined}
            aria-current={isActive ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            <span class="nav-label">
              <span data-shell-label data-ko={item.koLabel} data-en={item.enLabel}>{item.label}</span>
            </span>
            {item.external && <span aria-hidden="true">↗</span>}
          </a>
        );
      })}
    </nav>

    <div class="header-actions">
      <a href={productFacts.repositoryUrl} class="github-action-link" aria-label="GitHub Repository" target="_blank" rel="noopener noreferrer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="github-icon" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        <span class="github-stars-badge" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          <span class="github-stars-count">...</span>
        </span>
      </a>
      <div class="header-divider desktop-only"></div>
      <div class="desktop-preferences"><SitePreferences locale={locale} idPrefix="desktop" adaptiveLocale={adaptiveLocale} /></div>
      <button class="mobile-menu-btn" type="button" aria-label={messages.openMenu} aria-expanded="false" aria-controls="mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<MobileNavigationDrawer locale={locale} adaptiveLocale={adaptiveLocale} />

<style>
  .site-header { position: sticky; top: 0; z-index: 100; border-bottom: 1px solid color-mix(in srgb, var(--site-border) 84%, transparent); background: color-mix(in srgb, var(--site-page-bg) 88%, transparent); box-shadow: 0 10px 30px -32px rgba(15, 23, 42, 0.75); backdrop-filter: saturate(160%) blur(16px); transition: transform 180ms ease; will-change: transform; }
  .site-header.is-scroll-hidden { transform: translateY(calc(-100% - 1px)); }
  .header-inner { display: grid; grid-template-columns: 1fr auto 1fr; min-height: 68px; align-items: center; gap: 22px; }
  .brand { display: inline-flex; width: max-content; align-items: center; gap: 10px; color: var(--site-text-primary); text-decoration: none; }
  .brand-lockup { display: inline-flex; align-items: center; gap: 9px; }
  .brand:hover, .primary-nav a:hover { text-decoration: none; }
  .brand-symbol { display: block; width: 36px; height: 24px; flex: 0 0 auto; }
  .brand-name { color: var(--site-text-primary); font-size: 19px; font-weight: 800; line-height: 1; letter-spacing: -0.03em; }
  .brand-name span { color: var(--site-accent-strong); }
  .version-badge { padding: 2px 6px; background: var(--site-control-bg, rgba(15, 23, 42, 0.05)); color: var(--site-text-secondary); border-radius: 6px; font-family: var(--site-font-mono); font-size: 13px; font-weight: 600; letter-spacing: -0.01em; margin-top: 2px; }
  .primary-nav { display: flex; align-items: center; gap: 16px; }
  .learn-nav-menu { position: relative; display: flex; align-items: center; }
  .learn-nav-menu.is-open::after { position: absolute; top: 100%; left: 0; width: 100%; height: 16px; content: ''; }
  .primary-nav a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: var(--site-radius-sm, 8px); color: var(--site-text-secondary); font-size: 14px; font-weight: 700; line-height: 1.4; transition: color 150ms ease, background-color 150ms ease; white-space: nowrap; }
  .nav-label { display: inline-flex; align-items: center; gap: 6px; }
  .learn-nav-caret { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.6; transition: transform 150ms ease; }
  .learn-nav-menu.is-open .learn-nav-caret { transform: rotate(180deg); }
  .learn-nav-popover { position: fixed; top: 68px; left: 50%; z-index: 110; width: min(1120px, calc(100vw - 40px)); overflow: hidden; border: 1px solid var(--site-border); border-radius: 0 0 var(--site-radius-lg) var(--site-radius-lg); background: color-mix(in srgb, var(--site-surface-elevated) 96%, transparent); box-shadow: var(--site-shadow-menu); opacity: 0; pointer-events: none; transform: translate(-50%, -8px); visibility: hidden; backdrop-filter: saturate(150%) blur(18px); }
  .learn-nav-menu.is-open .learn-nav-popover { opacity: 1; pointer-events: auto; transform: translate(-50%, 0); visibility: visible; }
  .learn-popover-head { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 24px; padding: 16px 22px; border-bottom: 1px solid var(--site-border); background: color-mix(in srgb, var(--site-accent-soft) 42%, var(--site-surface-elevated)); }
  .learn-popover-head > div { display: flex; min-width: 0; align-items: baseline; gap: 12px; }
  .learn-popover-head strong { color: var(--site-text-primary); font-size: 16px; letter-spacing: -.025em; white-space: nowrap; }
  .learn-popover-head > div > span { overflow: hidden; color: var(--site-text-secondary); font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .primary-nav .learn-popover-all { flex: 0 0 auto; padding: 7px 10px; color: var(--site-accent-strong); font-size: 13px; }
  .learn-popover-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; padding: 18px 12px 20px; }
  .learn-popover-group { min-width: 0; padding: 0 10px; border-right: 1px solid var(--site-border); }
  .learn-popover-group:nth-child(3) { grid-column: span 2; }
  .learn-popover-group:nth-child(3) ul { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 4px; }
  .learn-popover-group:last-child { border-right: 0; }
  .learn-popover-group h2 { margin: 0 8px 9px; color: var(--site-text-muted); font-size: 13px; font-weight: 800; letter-spacing: .06em; line-height: 1.4; text-transform: uppercase; }
  .learn-popover-group ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; }
  .learn-popover-group li { min-width: 0; }
  .primary-nav .learn-popover-group a { display: flex; min-width: 0; justify-content: space-between; gap: 6px; padding: 6px 8px; border-radius: 7px; color: var(--site-text-secondary); font-size: 13px; font-weight: 650; line-height: 1.35; white-space: normal; }
  .learn-popover-group a span { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .learn-popover-group a i { flex: 0 0 auto; color: var(--site-text-muted); font-style: normal; opacity: 0; transform: translateX(-3px); transition: opacity 120ms ease, transform 120ms ease; }
  .primary-nav .learn-popover-group a:hover, .primary-nav .learn-popover-group a:focus-visible { background: var(--site-control-hover-bg); color: var(--site-text-primary); outline: none; text-decoration: none; }
  .learn-popover-group a:hover i, .learn-popover-group a:focus-visible i { opacity: 1; transform: translateX(0); }
  .github-stars-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 6px; border-radius: 6px; background: color-mix(in srgb, var(--site-text-primary) 6%, transparent); color: var(--site-text-primary); font-size: 13px; font-weight: 650; margin-left: 6px; font-variant-numeric: tabular-nums; }
  .github-stars-badge svg { fill: none; stroke: currentColor; opacity: 0.6; width: 14px; height: 14px; }
  :global(.github-icon) { display: block; width: 16px; height: 16px; flex: 0 0 auto; opacity: 0.8; }
  .primary-nav a:hover { color: var(--site-text-primary); background-color: var(--site-control-hover-bg, rgba(15, 23, 42, 0.05)); }
  .primary-nav a.active { color: var(--site-accent-strong); background-color: var(--site-accent-soft); font-weight: 750; }
  .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 16px; }
  .github-action-link { display: inline-flex; align-items: center; color: var(--site-text-secondary); text-decoration: none; transition: color 150ms ease; }
  .github-action-link:hover { color: var(--site-text-primary); }
  .header-divider { width: 1px; height: 24px; background: color-mix(in srgb, var(--site-border) 60%, transparent); }
  .mobile-menu-btn { display: none; width: 44px; height: 44px; border: 1px solid transparent; border-radius: 8px; padding: 11px; background: transparent; color: var(--site-text-primary); cursor: pointer; transition: background-color 150ms ease; }
  .mobile-menu-btn span { display: block; width: 100%; height: 2px; margin: 3px 0; border-radius: 2px; background: currentColor; transition: transform 150ms ease, opacity 150ms ease; }
  .mobile-menu-btn:hover { background: var(--site-control-hover-bg); }
  .mobile-menu-btn[aria-expanded='true'] span:first-child { transform: translateY(5px) rotate(45deg); }
  .mobile-menu-btn[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .mobile-menu-btn[aria-expanded='true'] span:last-child { transform: translateY(-5px) rotate(-45deg); }
  @media (max-width: 1080px) { .primary-nav { gap: 8px; } .primary-nav a { padding: 8px 12px; } .header-inner { gap: 14px; } .learn-nav-popover { width: calc(100vw - 24px); } .learn-popover-grid { padding-inline: 6px; } .learn-popover-group { padding-inline: 7px; } }
  @media (max-width: 960px) {
    .header-inner { display: flex; justify-content: space-between; gap: 12px; }
    .desktop-only, .desktop-preferences { display: none; }
    .header-actions { gap: 8px; }
    .github-action-link { min-width: 0; }
    .github-action-link .github-icon { display: none; }
    .github-stars-badge { margin-left: 0; }
    .mobile-menu-btn { display: block; flex: 0 0 auto; }
  }
  @media (max-width: 420px) { .brand { gap: 7px; } .brand-lockup { gap: 7px; } .brand-symbol { width: 36px; height: 24px; } .brand-name { font-size: 17px; } .version-badge { display: none; } }
  @media (prefers-reduced-motion: reduce) { .site-header, .learn-nav-caret, .learn-popover-group a i { transition: none; } }
</style>

<script is:inline define:vars={{
  adaptiveLocale,
  openLabel: messages.openMenu,
  closeLabel: messages.closeMenu,
  koPrimaryNavigation: commonMessages.ko.primaryNavigation,
  enPrimaryNavigation: commonMessages.en.primaryNavigation,
  koMobileNavigation: commonMessages.ko.mobileNavigation,
  enMobileNavigation: commonMessages.en.mobileNavigation,
  koOpenMenu: commonMessages.ko.openMenu,
  enOpenMenu: commonMessages.en.openMenu,
  koCloseMenu: commonMessages.ko.closeMenu,
  enCloseMenu: commonMessages.en.closeMenu,
}}>
  const shellLocale = adaptiveLocale && (window.location.pathname === '/en' || window.location.pathname.startsWith('/en/')) ? 'en' : document.documentElement.lang === 'en' ? 'en' : 'ko';
  const activeOpenLabel = shellLocale === 'en' ? enOpenMenu : koOpenMenu;
  const activeCloseLabel = shellLocale === 'en' ? enCloseMenu : koCloseMenu;
  if (adaptiveLocale) {
    const localizeShellPath = (path) => shellLocale === 'en' ? `/en${path === '/' ? '/' : path}` : path;
    document.querySelectorAll('[data-shell-label]').forEach((label) => { label.textContent = label.dataset[shellLocale] || label.textContent; });
    document.querySelectorAll('[data-shell-route]').forEach((link) => { link.href = localizeShellPath(link.dataset.shellRoute); });
    const home = document.querySelector('[data-shell-home]');
    if (home) { home.href = localizeShellPath('/'); home.setAttribute('aria-label', shellLocale === 'en' ? 'BeautifulGrid Home' : 'BeautifulGrid 홈'); }
    document.querySelector('[data-shell-navigation="primary"]')?.setAttribute('aria-label', shellLocale === 'en' ? enPrimaryNavigation : koPrimaryNavigation);
    document.querySelector('[data-shell-navigation="mobile"]')?.setAttribute('aria-label', shellLocale === 'en' ? enMobileNavigation : koMobileNavigation);
  }

  const updateActiveNav = () => {
    const path = window.location.pathname;
    document.querySelectorAll('.primary-nav [data-shell-route]').forEach((link) => {
      const route = link.dataset.shellRoute;
      if (!route) return;
      let isActive = false;
      if (route === '/learn') {
        isActive = path === '/learn' || path.startsWith('/learn/') || path === '/en/learn' || path.startsWith('/en/learn/') || path.startsWith('/examples/') || path.startsWith('/demo/') || path.startsWith('/docs/');
      } else if (route === '/api/props') {
        isActive = path === '/api/props' || path.startsWith('/api/') || path === '/en/api/props' || path.startsWith('/en/api/');
      } else {
        isActive = path === route || path === `/en${route}` || path.startsWith(`${route}/`) || path.startsWith(`/en${route}/`);
      }
      link.classList.toggle('active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  };
  updateActiveNav();

  const learnNavMenu = document.querySelector('[data-learn-nav-menu]');
  const learnNavTrigger = learnNavMenu?.querySelector('.learn-nav-trigger');
  const learnNavPopover = learnNavMenu?.querySelector('[data-learn-nav-popover]');
  let learnNavCloseTimer = 0;

  const openLearnNavigation = () => {
    if (!learnNavMenu || !learnNavTrigger || !learnNavPopover) return;
    window.clearTimeout(learnNavCloseTimer);
    learnNavMenu.classList.add('is-open');
    learnNavTrigger.setAttribute('aria-expanded', 'true');
    learnNavPopover.setAttribute('aria-hidden', 'false');
  };

  const closeLearnNavigation = ({ returnFocus = false, delay = 0 } = {}) => {
    window.clearTimeout(learnNavCloseTimer);
    learnNavCloseTimer = window.setTimeout(() => {
      if (!learnNavMenu || !learnNavTrigger || !learnNavPopover) return;
      learnNavMenu.classList.remove('is-open');
      learnNavTrigger.setAttribute('aria-expanded', 'false');
      learnNavPopover.setAttribute('aria-hidden', 'true');
      if (returnFocus) learnNavTrigger.focus();
    }, delay);
  };

  learnNavMenu?.addEventListener('mouseenter', openLearnNavigation);
  learnNavMenu?.addEventListener('mouseleave', () => closeLearnNavigation({ delay: 120 }));
  learnNavMenu?.addEventListener('focusin', openLearnNavigation);
  learnNavMenu?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!learnNavMenu.contains(document.activeElement)) closeLearnNavigation();
    });
  });
  learnNavMenu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      closeLearnNavigation({ returnFocus: true });
    }
  });
  document.addEventListener('pointerdown', (event) => {
    if (learnNavMenu && !learnNavMenu.contains(event.target)) closeLearnNavigation();
  });

  const button = document.querySelector('.mobile-menu-btn');
  const siteHeader = document.querySelector('.site-header');
  const drawerRoot = document.querySelector('[data-mobile-drawer]');
  const drawerPanel = drawerRoot?.querySelector('.mobile-drawer-panel');
  const drawerBackdrop = drawerRoot?.querySelector('[data-drawer-backdrop]');
  const drawerCloseBtn = drawerRoot?.querySelector('[data-drawer-close]');

  let isTransitioning = false;
  let lockedScrollY = 0;
  let pageScrollLocked = false;
  let lastHeaderScrollY = Math.max(window.scrollY, 0);
  let headerScrollFrame = 0;

  const setHeaderHidden = (hidden) => {
    const drawerOpen = drawerRoot?.classList.contains('is-open');
    const shouldHide = hidden && !drawerOpen;
    siteHeader?.classList.toggle('is-scroll-hidden', shouldHide);
    if (shouldHide) {
      document.documentElement.setAttribute('data-site-header-hidden', 'true');
    } else {
      document.documentElement.removeAttribute('data-site-header-hidden');
    }
  };

  const lockPageScroll = () => {
    if (pageScrollLocked) return;
    lockedScrollY = Math.max(window.scrollY, 0);
    pageScrollLocked = true;
    document.documentElement.classList.add('mobile-drawer-scroll-locked');
    document.body.classList.add('mobile-drawer-scroll-locked');
    document.body.style.top = `-${lockedScrollY}px`;
  };

  const unlockPageScroll = () => {
    if (!pageScrollLocked) return;
    document.documentElement.classList.remove('mobile-drawer-scroll-locked');
    document.body.classList.remove('mobile-drawer-scroll-locked');
    document.body.style.top = '';
    pageScrollLocked = false;
    window.scrollTo(0, lockedScrollY);
    lastHeaderScrollY = lockedScrollY;
  };

  const updateHeaderFromScroll = () => {
    headerScrollFrame = 0;
    const nextScrollY = Math.max(window.scrollY, 0);
    const delta = nextScrollY - lastHeaderScrollY;

    if (nextScrollY <= 16) {
      setHeaderHidden(false);
      lastHeaderScrollY = nextScrollY;
      return;
    }

    if (Math.abs(delta) < 6) return;
    setHeaderHidden(delta > 0);
    lastHeaderScrollY = nextScrollY;
  };

  window.addEventListener('scroll', () => {
    if (pageScrollLocked || headerScrollFrame) return;
    headerScrollFrame = requestAnimationFrame(updateHeaderFromScroll);
  }, { passive: true });

  const openNavigation = () => {
    if (!button || !drawerRoot || isTransitioning) return;
    isTransitioning = true;
    button.setAttribute('aria-expanded', 'true');
    button.setAttribute('aria-label', adaptiveLocale ? activeCloseLabel : closeLabel);
    drawerRoot.hidden = false;
    drawerRoot.setAttribute('aria-hidden', 'false');
    setHeaderHidden(false);
    lockPageScroll();

    // Force reflow so initial translate3d(100%, 0, 0) is committed by the renderer
    void drawerPanel?.offsetHeight;

    requestAnimationFrame(() => {
      drawerRoot.classList.add('is-open');
      isTransitioning = false;
    });

    const handleOpened = (e) => {
      if (e && e.target !== drawerPanel) return;
      drawerPanel?.removeEventListener('transitionend', handleOpened);
      const firstFocusable = drawerPanel?.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
      firstFocusable?.focus({ preventScroll: true });
    };

    drawerPanel?.addEventListener('transitionend', handleOpened);
    setTimeout(handleOpened, 320);
  };

  const closeNavigation = (returnFocus = false) => {
    if (!button || !drawerRoot) return;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', adaptiveLocale ? activeOpenLabel : openLabel);
    drawerRoot.classList.remove('is-open');
    unlockPageScroll();

    const handleTransitionEnd = (e) => {
      if (e.target !== drawerPanel) return;
      drawerPanel?.removeEventListener('transitionend', handleTransitionEnd);
      if (!drawerRoot.classList.contains('is-open')) {
        drawerRoot.hidden = true;
        drawerRoot.setAttribute('aria-hidden', 'true');
      }
    };

    drawerPanel?.addEventListener('transitionend', handleTransitionEnd);
    // Fallback if transition doesn't fire
    setTimeout(() => {
      if (!drawerRoot.classList.contains('is-open')) {
        drawerRoot.hidden = true;
        drawerRoot.setAttribute('aria-hidden', 'true');
      }
    }, 300);

    if (returnFocus) button.focus();
  };

  button?.addEventListener('click', () => {
    const isExpanded = button.getAttribute('aria-expanded') === 'true';
    if (isExpanded) {
      closeNavigation(false);
    } else {
      openNavigation();
    }
  });

  drawerCloseBtn?.addEventListener('click', () => closeNavigation(true));
  drawerBackdrop?.addEventListener('click', () => closeNavigation(true));

  drawerRoot?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      event.preventDefault();
      closeNavigation(true);
      return;
    }

    if (event.key === 'Tab' && drawerPanel) {
      const focusableEls = Array.from(
        drawerPanel.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])')
      ).filter(el => !el.hidden && getComputedStyle(el).display !== 'none');

      if (focusableEls.length === 0) return;
      const firstEl = focusableEls[0];
      const lastEl = focusableEls[focusableEls.length - 1];

      if (event.shiftKey) {
        if (document.activeElement === firstEl) {
          event.preventDefault();
          lastEl.focus();
        }
      } else {
        if (document.activeElement === lastEl) {
          event.preventDefault();
          firstEl.focus();
        }
      }
    }
  });

  drawerPanel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      closeNavigation(false);
    });
  });

  window.matchMedia('(min-width: 961px)').addEventListener('change', (event) => {
    if (event.matches) closeNavigation(false);
  });

  fetch('https://api.github.com/repos/axisj/beautiful-grid')
    .then(res => res.json())
    .then(data => {
      if (data.stargazers_count !== undefined) {
        document.querySelectorAll('.github-stars-count').forEach(el => {
          el.textContent = new Intl.NumberFormat('en-US').format(data.stargazers_count);
          el.parentElement.style.display = 'inline-flex';
        });
      }
    })
    .catch(e => console.error('Failed to load GitHub stars:', e));
</script>
