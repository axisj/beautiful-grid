---
import type { CollectionEntry } from 'astro:content';
import {
  ArrowRight,
  BookOpen,
  Boxes,
  Braces,
  Code2,
  MousePointer2,
  Palette,
  Play,
  Rocket,
  Search,
} from 'lucide-react';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import type { Locale } from '../../i18n';
import {
  categoryLabel,
  learnCategoryOrder,
  learnDemoPath,
  learnIndexPath,
  learnMessages,
  learnPath,
  learnSlug,
} from './learnLocale';

interface Props {
  locale: Locale;
  items: CollectionEntry<'learn'>[];
}

const { locale, items } = Astro.props;
const messages = learnMessages[locale];
const visibleItems = items
  .filter(item => item.data.locale === locale && !item.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const pageCopy = locale === 'en'
  ? {
      pathsEyebrow: 'CURATED LEARNING PATHS',
      pathsTitle: 'Quick Start Guid',
      pathsIntro: 'Each path connects the smallest useful set of guides, so you can learn a workflow without reading the entire catalog first.',
      catalogTitle: 'Explore the complete toolkit.',
      searchLabel: 'Search the guide catalog',
      searchPlaceholder: 'Search editing, pivot, virtual scroll…',
      results: (count: number) => `${count} ${count === 1 ? 'guide' : 'guides'}`,
      noResultsTitle: 'No matching guides found',
      noResultsBody: 'Try a feature name such as editing, selection, columns, or styling.',
      liveDemo: 'Live demo',
      openGuide: 'Open guide',
      openDemo: 'Open demo',
      categoryJump: 'Jump to a learning area',
      tracks: [
        { label: '01 · FOUNDATION', title: 'Ship your first grid', description: 'Install the package, connect data and columns, and establish a responsive grid surface.', slugs: ['getting-started', 'basic', 'data-and-columns'] },
        { label: '02 · WORKFLOW', title: 'Build confident interactions', description: 'Add keyboard navigation, cell editing, and production-ready editor patterns.', slugs: ['cell-navigation', 'editing', 'built-in-editors'] },
        { label: '03 · PRODUCTION', title: 'Prepare for real workloads', description: 'Tune large datasets, accessibility, and visual integration for a finished product.', slugs: ['virtual-scroll', 'accessibility-and-keyboard', 'theming'] },
      ],
    }
  : {
      pathsEyebrow: 'CURATED LEARNING PATHS',
      pathsTitle: 'Quick Start Guid',
      pathsIntro: '전체 문서를 순서대로 읽지 않아도 됩니다. 지금 만들고 싶은 결과에 꼭 필요한 가이드만 연결했습니다.',
      catalogTitle: '필요한 기능을 빠르게 찾아보세요.',
      searchLabel: '가이드 카탈로그 검색',
      searchPlaceholder: '편집, 피벗, 가상 스크롤 검색…',
      results: (count: number) => `${count}개 가이드`,
      noResultsTitle: '일치하는 가이드가 없습니다',
      noResultsBody: '편집, 선택, 컬럼, 스타일처럼 다른 기능 이름으로 검색해 보세요.',
      liveDemo: '라이브 데모',
      openGuide: '가이드 열기',
      openDemo: '데모 열기',
      categoryJump: '학습 영역 바로가기',
      tracks: [
        { label: '01 · FOUNDATION', title: '첫 그리드 완성하기', description: '패키지를 설치하고 데이터와 컬럼을 연결해 반응형 그리드 화면을 완성합니다.', slugs: ['getting-started', 'basic', 'data-and-columns'] },
        { label: '02 · WORKFLOW', title: '업무 상호작용 설계하기', description: '키보드 탐색, 셀 편집과 실전 에디터 패턴을 자연스러운 흐름으로 연결합니다.', slugs: ['cell-navigation', 'editing', 'built-in-editors'] },
        { label: '03 · PRODUCTION', title: '운영 환경 준비하기', description: '대용량 데이터, 접근성, 테마를 점검해 제품 수준의 그리드로 다듬습니다.', slugs: ['virtual-scroll', 'accessibility-and-keyboard', 'theming'] },
      ],
    };

const categoryMeta = {
  'getting-started': {
    icon: Rocket,
    number: '01',
    description: locale === 'en' ? 'Install, render, and understand the essential grid model.' : '설치부터 첫 렌더링까지 핵심 구조를 익힙니다.',
  },
  'data-and-columns': {
    icon: Braces,
    number: '02',
    description: locale === 'en' ? 'Shape data, columns, grouping, and presentation rules.' : '데이터와 컬럼, 그룹 및 표현 규칙을 설계합니다.',
  },
  interaction: {
    icon: MousePointer2,
    number: '03',
    description: locale === 'en' ? 'Build selection, navigation, editing, and user workflows.' : '선택·탐색·편집을 자연스러운 업무 흐름으로 연결합니다.',
  },
  advanced: {
    icon: Boxes,
    number: '04',
    description: locale === 'en' ? 'Handle scale, summaries, pivoting, and complex layouts.' : '대용량 처리, 요약, 피벗과 복합 레이아웃을 다룹니다.',
  },
  'styling-and-accessibility': {
    icon: Palette,
    number: '05',
    description: locale === 'en' ? 'Finish the experience with themes and accessible behavior.' : '테마와 접근성으로 제품의 완성도를 높입니다.',
  },
} as const;

const grouped = learnCategoryOrder
  .map(category => ({
    category,
    label: categoryLabel(category, locale),
    meta: categoryMeta[category],
    items: visibleItems.filter(item => item.data.category === category),
  }))
  .filter(group => group.items.length > 0);

const findItem = (slug: string) => visibleItems.find(item => learnSlug(item.id) === slug);
const tracks = pageCopy.tracks.map(track => ({
  ...track,
  items: track.slugs.map(findItem).filter((item): item is CollectionEntry<'learn'> => Boolean(item)),
}));
---

<MarketingLayout title={messages.indexTitle} description={messages.indexDescription} canonicalPath={learnIndexPath(locale)} locale={locale}>
  <main class="learn-hub">
    <section class="container learning-paths" aria-labelledby="learning-paths-title">
      <div class="learn-section-heading">
        <div>
          <p>{pageCopy.pathsEyebrow}</p>
          <h2 id="learning-paths-title">{pageCopy.pathsTitle}</h2>
        </div>
        <p>{pageCopy.pathsIntro}</p>
      </div>

      <div class="learning-path-grid">
        {tracks.map((track, trackIndex) => (
          <article class:list={['learning-path-card', `learning-path-card--${trackIndex + 1}`]}>
            <div class="path-card-head"><span>{track.label}</span><strong>0{track.items.length}</strong></div>
            <div class="path-card-icon" aria-hidden="true">
              {trackIndex === 0 ? <Rocket size={23} /> : trackIndex === 1 ? <MousePointer2 size={23} /> : <Code2 size={23} />}
            </div>
            <h3>{track.title}</h3>
            <p>{track.description}</p>
            <ol>
              {track.items.map((item, index) => (
                <li>
                  <a href={learnPath(learnSlug(item.id), locale)}>
                    <span>{index + 1}</span>
                    <strong>{item.data.title}</strong>
                  </a>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </section>

    <div class="learn-finder-bar">
      <div class="container learn-finder-bar-inner">
        <div class="learn-finder-search">
          <label class="learn-visually-hidden" for="learn-catalog-search">{pageCopy.searchLabel}</label>
          <div class="catalog-search">
            <Search size={17} strokeWidth={1.9} aria-hidden="true" />
            <input id="learn-catalog-search" type="search" placeholder={pageCopy.searchPlaceholder} autocomplete="off" data-learn-search />
            <kbd>/</kbd>
          </div>
        </div>
        <nav class="learn-shortcuts" aria-label={pageCopy.categoryJump}>
          {grouped.map(group => (
            <a href={`#category-${group.category}`}>
              <group.meta.icon size={14} strokeWidth={1.9} aria-hidden="true" />
              <strong>{group.label}</strong>
              <small>{group.items.length}</small>
            </a>
          ))}
        </nav>
        <a class="learn-finder-result" href="#guide-catalog"><strong data-result-count>{pageCopy.results(visibleItems.length)}</strong><ArrowRight size={13} aria-hidden="true" /></a>
      </div>
    </div>

    <section class="guide-catalog" id="guide-catalog" aria-label={pageCopy.catalogTitle}>
      <div class="container">
        <div class="catalog-groups">
          {grouped.map(group => (
            <section class="catalog-group" id={`category-${group.category}`} data-guide-group>
              <header class="catalog-group-head">
                <div class="catalog-group-index">{group.meta.number}</div>
                <div class="catalog-group-icon"><group.meta.icon size={21} strokeWidth={1.8} aria-hidden="true" /></div>
                <div><h3>{group.label}</h3><p>{group.meta.description}</p></div>
                <span>{messages.guideCount(group.items.length)}</span>
              </header>

              <div class="guide-card-grid">
                {group.items.map((item, itemIndex) => {
                  const slug = learnSlug(item.id);
                  const hasDemo = Boolean(item.data.demoId);
                  const hasStandaloneDemo = item.data.demoId === slug;
                  const searchText = [item.data.title, item.data.description, ...item.data.features].join(' ').toLocaleLowerCase(locale);
                  return (
                    <article class="guide-card" data-guide-card data-search={searchText}>
                      <div class="guide-card-top">
                        <span class="guide-number">{group.meta.number}.{String(itemIndex + 1).padStart(2, '0')}</span>
                        {hasDemo && <span class="guide-live"><span></span>{pageCopy.liveDemo}</span>}
                      </div>
                      <h4><a href={learnPath(slug, locale)}>{item.data.title}</a></h4>
                      <p>{item.data.description}</p>
                      <div class="guide-tags">
                        {item.data.features.slice(0, 4).map(feature => <span>{feature}</span>)}
                        {item.data.features.length > 4 && <span>+{item.data.features.length - 4}</span>}
                      </div>
                      <div class="guide-card-actions">
                        <a href={learnPath(slug, locale)}>{pageCopy.openGuide}<ArrowRight size={14} aria-hidden="true" /></a>
                        {hasStandaloneDemo && <a href={learnDemoPath(slug, locale)} target="_blank" rel="noopener noreferrer"><Play size={12} fill="currentColor" aria-hidden="true" />{pageCopy.openDemo}</a>}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          ))}
        </div>

        <div class="catalog-empty" data-catalog-empty hidden>
          <BookOpen size={28} strokeWidth={1.6} aria-hidden="true" />
          <strong>{pageCopy.noResultsTitle}</strong>
          <p>{pageCopy.noResultsBody}</p>
        </div>
      </div>
    </section>
  </main>
</MarketingLayout>

<style>
  .learn-hub { background: var(--site-page-bg); }
  .learn-visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .learn-finder-bar { position: sticky; top: var(--site-header-offset, 68px); z-index: 60; border-bottom: 1px solid var(--site-border); background: color-mix(in srgb, var(--site-page-bg) 92%, transparent); box-shadow: 0 12px 28px -28px rgba(15, 23, 42, .8); backdrop-filter: blur(16px) saturate(160%); transition: top 180ms ease; }
  .learn-finder-bar-inner { display: grid; grid-template-columns: minmax(260px, 340px) minmax(0, 1fr) auto; gap: 12px; align-items: center; min-height: 66px; }
  .learn-shortcuts { display: flex; gap: 4px; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .learn-shortcuts::-webkit-scrollbar { display: none; }
  .learn-shortcuts a { display: inline-flex; flex: 0 0 auto; gap: 6px; align-items: center; min-height: 36px; border: 1px solid transparent; border-radius: 9px; padding: 0 8px; color: var(--site-text-secondary); text-decoration: none; transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease; }
  .learn-shortcuts a:hover { border-color: var(--site-border); background: var(--site-surface); color: var(--site-accent-strong); }
  .learn-shortcuts a :global(svg) { color: var(--site-text-muted); }
  .learn-shortcuts strong { font-size: 13px; font-weight: 730; white-space: nowrap; }
  .learn-shortcuts small { display: grid; min-width: 18px; height: 18px; place-items: center; border-radius: 999px; background: var(--site-surface); color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; }
  .learn-finder-result { display: inline-flex; gap: 4px; align-items: center; color: var(--site-accent-strong); font-size: 13px; text-decoration: none; white-space: nowrap; }
  .learn-finder-result strong { font-family: var(--site-font-mono); }
  .learning-paths { padding-top: 72px; padding-bottom: 118px; }
  .learn-section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .65fr); gap: clamp(44px, 8vw, 120px); align-items: end; }
  .learn-section-heading > div > p { margin: 0 0 16px; color: var(--site-accent-strong); font-size: 13px; font-weight: 850; letter-spacing: .13em; }
  .learn-section-heading h2 { max-width: 720px; margin: 0; color: var(--site-text-primary); font-size: clamp(36px, 4vw, 54px); line-height: 1.08; letter-spacing: -.06em; word-break: keep-all; }
  .learn-section-heading > p { margin: 0 0 4px; color: var(--site-text-secondary); font-size: 15px; line-height: 1.75; word-break: keep-all; }
  .learning-path-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin-top: 50px; }
  .learning-path-card { position: relative; overflow: hidden; border: 1px solid var(--site-border); border-radius: 22px; padding: 27px; background: var(--site-surface-elevated); box-shadow: 0 24px 60px -52px rgba(15, 23, 42, .7); transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease; }
  .learning-path-card:hover { border-color: var(--site-border-strong); box-shadow: 0 30px 65px -50px rgba(15, 23, 42, .75); transform: translateY(-4px); }
  .learning-path-card::after { position: absolute; right: -70px; top: -80px; width: 210px; height: 210px; border-radius: 50%; background: color-mix(in srgb, var(--site-accent) 8%, transparent); content: ''; }
  .learning-path-card--2::after { background: color-mix(in srgb, #8b5cf6 9%, transparent); }
  .learning-path-card--3::after { background: color-mix(in srgb, #0d9488 9%, transparent); }
  .path-card-head { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; }
  .path-card-head span { color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; font-weight: 800; letter-spacing: .08em; }
  .path-card-head strong { color: var(--site-border-strong); font-family: var(--site-font-mono); font-size: 24px; }
  .path-card-icon { display: grid; width: 48px; height: 48px; margin: 31px 0 22px; place-items: center; border: 1px solid color-mix(in srgb, var(--site-accent) 22%, var(--site-border)); border-radius: 14px; background: var(--site-accent-soft); color: var(--site-accent-strong); }
  .learning-path-card--2 .path-card-icon { border-color: color-mix(in srgb, #8b5cf6 22%, var(--site-border)); background: color-mix(in srgb, #8b5cf6 9%, var(--site-surface)); color: #7c3aed; }
  .learning-path-card--3 .path-card-icon { border-color: color-mix(in srgb, #0d9488 22%, var(--site-border)); background: color-mix(in srgb, #0d9488 9%, var(--site-surface)); color: #0d9488; }
  .learning-path-card h3 { margin: 0 0 12px; color: var(--site-text-primary); font-size: 21px; letter-spacing: -.04em; }
  .learning-path-card > p { min-height: 66px; margin: 0; color: var(--site-text-secondary); font-size: 13px; line-height: 1.7; word-break: keep-all; }
  .learning-path-card ol { display: grid; gap: 0; list-style: none; margin: 22px 0 0; padding: 0; border-top: 1px solid var(--site-border); }
  .learning-path-card li { border-bottom: 1px solid var(--site-border); overflow: hidden; }
  .learning-path-card li a { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 8px; align-items: center; min-height: 42px; color: var(--site-text-secondary); font-size: 13px; text-decoration: none; }
  .learning-path-card li a:hover, .learning-path-card li a:focus-visible { color: var(--site-accent-strong); }
  .learning-path-card li span { color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; }
  .learning-path-card li strong { overflow: hidden; font-weight: 500; text-overflow: ellipsis; white-space: nowrap; }
  .guide-catalog { padding: 72px 0 128px; border-top: 1px solid var(--site-border); background: color-mix(in srgb, var(--site-surface) 64%, var(--site-page-bg)); }
  .catalog-search { display: grid; grid-template-columns: 20px minmax(0, 1fr) auto; gap: 8px; align-items: center; min-height: 40px; border: 1px solid var(--site-border-strong); border-radius: 9px; padding: 0 10px; background: var(--site-control-bg); color: var(--site-text-muted); transition: border-color 150ms ease, box-shadow 150ms ease; }
  .catalog-search:focus-within { border-color: var(--site-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--site-accent) 13%, transparent); }
  .catalog-search input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--site-text-primary); font: inherit; font-size: 14px; }
  .catalog-search input::placeholder { color: var(--site-text-muted); }
  .catalog-search kbd { display: grid; width: 22px; height: 22px; place-items: center; border: 1px solid var(--site-border); border-radius: 5px; background: var(--site-surface); color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; }
  .catalog-groups { display: grid; gap: 100px; }
  .catalog-group { scroll-margin-top: 158px; }
  .catalog-group-head { display: grid; grid-template-columns: 46px 46px 1fr auto; gap: 14px; align-items: center; margin-bottom: 22px; padding-bottom: 19px; border-bottom: 1px solid var(--site-border-strong); }
  .catalog-group-index { color: var(--site-border-strong); font-family: var(--site-font-mono); font-size: 25px; font-weight: 800; letter-spacing: -.06em; }
  .catalog-group-icon { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid var(--site-border); border-radius: 12px; background: var(--site-surface-elevated); color: var(--site-accent-strong); }
  .catalog-group-head h3 { margin: 0 0 4px; color: var(--site-text-primary); font-size: 20px; letter-spacing: -.035em; }
  .catalog-group-head p { margin: 0; color: var(--site-text-muted); font-size: 13px; }
  .catalog-group-head > span { color: var(--site-text-muted); font-size: 13px; font-weight: 700; }
  .guide-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .guide-card { position: relative; display: flex; min-height: 330px; flex-direction: column; overflow: hidden; border: 1px solid var(--site-border); border-radius: 17px; padding: 22px; background: var(--site-surface-elevated); transition: transform 170ms ease, border-color 170ms ease, box-shadow 170ms ease; }
  .guide-card:hover { border-color: color-mix(in srgb, var(--site-accent) 32%, var(--site-border)); box-shadow: 0 28px 56px -48px rgba(15, 23, 42, .8); transform: translateY(-3px); }
  .guide-card::before { position: absolute; top: 0; left: 0; width: 100%; height: 2px; background: linear-gradient(90deg, var(--site-accent), transparent 72%); opacity: 0; content: ''; transition: opacity 170ms ease; }
  .guide-card:hover::before { opacity: 1; }
  .guide-card-top { display: flex; justify-content: space-between; align-items: center; min-height: 23px; }
  .guide-number { color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; font-weight: 800; letter-spacing: .06em; }
  .guide-live { display: inline-flex; align-items: center; gap: 5px; border: 1px solid color-mix(in srgb, #10b981 20%, var(--site-border)); border-radius: 999px; padding: 4px 7px; background: color-mix(in srgb, #10b981 7%, var(--site-surface)); color: #059669; font-size: 13px; font-weight: 800; letter-spacing: .03em; text-transform: uppercase; }
  .guide-live span { width: 5px; height: 5px; border-radius: 50%; background: #10b981; }
  .guide-card h4 { margin: 25px 0 11px; font-size: 18px; line-height: 1.35; letter-spacing: -.035em; word-break: keep-all; }
  .guide-card h4 a { color: var(--site-text-primary); text-decoration: none; }
  .guide-card h4 a::after { position: absolute; inset: 0; z-index: 0; content: ''; }
  .guide-card > p { flex: 1; margin: 0 0 20px; color: var(--site-text-secondary); font-size: 13px; line-height: 1.7; word-break: keep-all; }
  .guide-tags { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 19px; }
  .guide-tags span { max-width: 100%; overflow: hidden; border: 1px solid var(--site-border); border-radius: 6px; padding: 3px 6px; background: var(--site-surface); color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; text-overflow: ellipsis; white-space: nowrap; }
  .guide-card-actions { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: center; gap: 10px; min-height: 34px; padding-top: 15px; border-top: 1px solid var(--site-border); }
  .guide-card-actions a { display: inline-flex; align-items: center; gap: 6px; color: var(--site-text-primary); font-size: 13px; font-weight: 790; text-decoration: none; }
  .guide-card-actions a:hover { color: var(--site-accent-strong); }
  .guide-card-actions a + a { color: var(--site-text-muted); }
  .catalog-empty { display: grid; max-width: 520px; justify-items: center; margin: 72px auto 0; border: 1px dashed var(--site-border-strong); border-radius: 18px; padding: 46px 24px; color: var(--site-text-muted); text-align: center; }
  .catalog-empty[hidden] { display: none; }
  .catalog-empty strong { margin-top: 15px; color: var(--site-text-primary); font-size: 16px; }
  .catalog-empty p { margin: 7px 0 0; color: var(--site-text-secondary); font-size: 13px; }
  :global(:root[data-theme='dark']) .learning-path-card--2 .path-card-icon { color: #c4b5fd; }
  :global(:root[data-theme='dark']) .learning-path-card--3 .path-card-icon { color: #5eead4; }
  :global(:root[data-theme='dark']) .guide-live { color: #6ee7b7; }
  @media (max-width: 1080px) {
    .learn-finder-bar-inner { grid-template-columns: minmax(240px, 300px) minmax(0, 1fr); }
    .learn-finder-result { display: none; }
    .guide-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .learn-section-heading { grid-template-columns: 1fr; gap: 24px; }
    .learn-section-heading > p { max-width: 650px; }
    .learning-path-grid { grid-template-columns: 1fr; }
    .learning-path-card { display: grid; grid-template-columns: 58px 1fr; column-gap: 18px; min-height: 0; }
    .path-card-head { grid-column: 1 / -1; }
    .path-card-icon { grid-column: 1; grid-row: 2 / span 2; margin: 28px 0 0; }
    .learning-path-card h3 { grid-column: 2; margin-top: 30px; }
    .learning-path-card > p, .learning-path-card ol { grid-column: 2; }
    .learning-path-card > p { min-height: 0; }
    .catalog-groups { gap: 80px; }
  }
  @media (max-width: 620px) {
    .learn-finder-bar-inner { grid-template-columns: 1fr; gap: 6px; padding-top: 8px; padding-bottom: 8px; }
    .learn-shortcuts { margin-inline: -4px; }
    .learn-shortcuts a { min-height: 32px; }
    .learning-paths { padding-top: 80px; padding-bottom: 84px; }
    .learn-section-heading h2 { font-size: 36px; }
    .learning-path-card { display: block; padding: 23px; }
    .path-card-icon { margin-top: 27px; }
    .learning-path-card h3 { margin-top: 20px; }
    .guide-catalog { padding-top: 56px; padding-bottom: 92px; }
    .catalog-groups { gap: 68px; }
    .catalog-group { scroll-margin-top: 190px; }
    .catalog-group-head { grid-template-columns: 38px 42px minmax(0, 1fr); gap: 10px; }
    .catalog-group-index { font-size: 21px; }
    .catalog-group-head > span { display: none; }
    .catalog-group-head p { line-height: 1.5; }
    .guide-card-grid { grid-template-columns: 1fr; }
