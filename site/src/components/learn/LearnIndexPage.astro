  }
  @media (prefers-reduced-motion: reduce) {
    .learning-path-card, .guide-card { transition: none; }
    .learning-path-card:hover, .guide-card:hover { transform: none; }
  }
</style>

<script is:inline define:vars={{ locale }}>
  const searchInput = document.querySelector('[data-learn-search]');
  const guideCards = [...document.querySelectorAll('[data-guide-card]')];
  const guideGroups = [...document.querySelectorAll('[data-guide-group]')];
  const resultCount = document.querySelector('[data-result-count]');
  const emptyState = document.querySelector('[data-catalog-empty]');

  const formatResultCount = (count) => locale === 'en'
    ? `${count} ${count === 1 ? 'guide' : 'guides'}`
    : `${count}개 가이드`;

  const applySearch = () => {
    const query = searchInput?.value.trim().toLocaleLowerCase() || '';
    let visibleCount = 0;

    guideCards.forEach(card => {
      const matches = !query || card.dataset.search.includes(query);
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });

    guideGroups.forEach(group => {
      group.hidden = !group.querySelector('[data-guide-card]:not([hidden])');
    });

    if (resultCount) resultCount.textContent = formatResultCount(visibleCount);
    if (emptyState) emptyState.hidden = visibleCount !== 0;
  };

  searchInput?.addEventListener('input', applySearch);
  searchInput?.addEventListener('keydown', event => {
    if (event.key === 'Enter') {
      event.preventDefault();
      document.querySelector('#guide-catalog')?.scrollIntoView({ behavior: 'smooth' });
    }
  });
  document.addEventListener('keydown', event => {
    if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
      event.preventDefault();
      searchInput?.focus();
    }
  });
</script>
