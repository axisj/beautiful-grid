---
import type { CollectionEntry } from 'astro:content';
import {
  ArrowRight,
  BookOpen,
  Boxes,
  Braces,
  Check,
  Code2,
  Compass,
  MousePointer2,
  Palette,
  Play,
  Rocket,
  Search,
  Sparkles,
} from 'lucide-react';
import MarketingLayout from '../../layouts/MarketingLayout.astro';
import type { Locale } from '../../i18n';
import {
  categoryLabel,
  learnCategoryOrder,
  learnDemoPath,
  learnIndexPath,
  learnMessages,
  learnPath,
  learnSlug,
} from './learnLocale';

interface Props {
  locale: Locale;
  items: CollectionEntry<'learn'>[];
}

const { locale, items } = Astro.props;
const messages = learnMessages[locale];
const visibleItems = items
  .filter(item => item.data.locale === locale && !item.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const pageCopy = locale === 'en'
  ? {
      eyebrow: 'BEAUTIFULGRID LEARNING CENTER',
      heroTitleStart: 'Find the pattern.',
      heroTitleAccent: 'Build the grid.',
      heroIntro: 'Move from your first render to editing, navigation, performance, and production polish with focused guides built around working examples.',
      primaryAction: 'Build your first grid',
      secondaryAction: 'Browse every guide',
      guideMetric: 'practical guides',
      demoMetric: 'live examples',
      categoryMetric: 'learning areas',
      curriculum: 'CURRICULUM MAP',
      curriculumTitle: 'A clear route from setup to production',
      curriculumStatus: 'Always open',
      pathsEyebrow: 'CURATED LEARNING PATHS',
      pathsTitle: 'Start with the outcome you need.',
      pathsIntro: 'Each path connects the smallest useful set of guides, so you can learn a workflow without reading the entire catalog first.',
      pathOpen: 'Start this path',
      catalogEyebrow: 'ALL GUIDES & EXAMPLES',
      catalogTitle: 'Explore the complete toolkit.',
      catalogIntro: 'Search by capability, API concept, or workflow. Every guide includes practical context and copy-ready source.',
      searchLabel: 'Search the guide catalog',
      searchPlaceholder: 'Search editing, pivot, virtual scroll…',
      searchHint: 'Search titles, descriptions, and feature tags',
      results: (count: number) => `${count} ${count === 1 ? 'guide' : 'guides'}`,
      noResultsTitle: 'No matching guides found',
      noResultsBody: 'Try a feature name such as editing, selection, columns, or styling.',
      liveDemo: 'Live demo',
      openGuide: 'Open guide',
      openDemo: 'Open demo',
      categoryJump: 'Jump to a learning area',
      tracks: [
        { label: '01 · FOUNDATION', title: 'Ship your first grid', description: 'Install the package, connect data and columns, and establish a responsive grid surface.', slugs: ['getting-started', 'basic', 'data-and-columns'] },
        { label: '02 · WORKFLOW', title: 'Build confident interactions', description: 'Add keyboard navigation, cell editing, and production-ready editor patterns.', slugs: ['cell-navigation', 'editing', 'built-in-editors'] },
        { label: '03 · PRODUCTION', title: 'Prepare for real workloads', description: 'Tune large datasets, accessibility, and visual integration for a finished product.', slugs: ['virtual-scroll', 'accessibility-and-keyboard', 'theming'] },
      ],
    }
  : {
      eyebrow: 'BEAUTIFULGRID LEARNING CENTER',
      heroTitleStart: '필요한 기능부터,',
      heroTitleAccent: '바로 실행해 보세요.',
      heroIntro: '첫 렌더링부터 편집·탐색·성능·제품 완성도까지, 실제로 동작하는 예제를 따라가며 BeautifulGrid를 익힐 수 있습니다.',
      primaryAction: '첫 그리드 만들기',
      secondaryAction: '전체 가이드 둘러보기',
      guideMetric: '실무 가이드',
      demoMetric: '라이브 예제',
      categoryMetric: '학습 영역',
      curriculum: 'CURRICULUM MAP',
      curriculumTitle: '설치부터 실전 적용까지 한 번에',
      curriculumStatus: '언제든 시작',
      pathsEyebrow: 'CURATED LEARNING PATHS',
      pathsTitle: '목표에 맞는 경로로 시작하세요.',
      pathsIntro: '전체 문서를 순서대로 읽지 않아도 됩니다. 지금 만들고 싶은 결과에 꼭 필요한 가이드만 연결했습니다.',
      pathOpen: '이 경로로 시작',
      catalogEyebrow: 'ALL GUIDES & EXAMPLES',
      catalogTitle: '필요한 기능을 빠르게 찾아보세요.',
      catalogIntro: '기능명, API 개념, 업무 흐름으로 검색할 수 있습니다. 모든 가이드에는 실무 설명과 바로 활용할 수 있는 소스가 포함됩니다.',
      searchLabel: '가이드 카탈로그 검색',
      searchPlaceholder: '편집, 피벗, 가상 스크롤 검색…',
      searchHint: '제목·설명·기능 태그를 함께 검색합니다',
      results: (count: number) => `${count}개 가이드`,
      noResultsTitle: '일치하는 가이드가 없습니다',
      noResultsBody: '편집, 선택, 컬럼, 스타일처럼 다른 기능 이름으로 검색해 보세요.',
      liveDemo: '라이브 데모',
      openGuide: '가이드 열기',
      openDemo: '데모 열기',
      categoryJump: '학습 영역 바로가기',
      tracks: [
        { label: '01 · FOUNDATION', title: '첫 그리드 완성하기', description: '패키지를 설치하고 데이터와 컬럼을 연결해 반응형 그리드 화면을 완성합니다.', slugs: ['getting-started', 'basic', 'data-and-columns'] },
        { label: '02 · WORKFLOW', title: '업무 상호작용 설계하기', description: '키보드 탐색, 셀 편집과 실전 에디터 패턴을 자연스러운 흐름으로 연결합니다.', slugs: ['cell-navigation', 'editing', 'built-in-editors'] },
        { label: '03 · PRODUCTION', title: '운영 환경 준비하기', description: '대용량 데이터, 접근성, 테마를 점검해 제품 수준의 그리드로 다듬습니다.', slugs: ['virtual-scroll', 'accessibility-and-keyboard', 'theming'] },
      ],
    };

const categoryMeta = {
  'getting-started': {
    icon: Rocket,
    number: '01',
    description: locale === 'en' ? 'Install, render, and understand the essential grid model.' : '설치부터 첫 렌더링까지 핵심 구조를 익힙니다.',
  },
  'data-and-columns': {
    icon: Braces,
    number: '02',
    description: locale === 'en' ? 'Shape data, columns, grouping, and presentation rules.' : '데이터와 컬럼, 그룹 및 표현 규칙을 설계합니다.',
  },
  interaction: {
    icon: MousePointer2,
    number: '03',
    description: locale === 'en' ? 'Build selection, navigation, editing, and user workflows.' : '선택·탐색·편집을 자연스러운 업무 흐름으로 연결합니다.',
  },
  advanced: {
    icon: Boxes,
    number: '04',
    description: locale === 'en' ? 'Handle scale, summaries, pivoting, and complex layouts.' : '대용량 처리, 요약, 피벗과 복합 레이아웃을 다룹니다.',
  },
  'styling-and-accessibility': {
    icon: Palette,
    number: '05',
    description: locale === 'en' ? 'Finish the experience with themes and accessible behavior.' : '테마와 접근성으로 제품의 완성도를 높입니다.',
  },
} as const;

const grouped = learnCategoryOrder
  .map(category => ({
    category,
    label: categoryLabel(category, locale),
    meta: categoryMeta[category],
    items: visibleItems.filter(item => item.data.category === category),
  }))
  .filter(group => group.items.length > 0);

const findItem = (slug: string) => visibleItems.find(item => learnSlug(item.id) === slug);
const tracks = pageCopy.tracks.map(track => ({
  ...track,
  items: track.slugs.map(findItem).filter((item): item is CollectionEntry<'learn'> => Boolean(item)),
}));
const demoCount = visibleItems.filter(item => item.data.demoId).length;
const firstGuide = findItem('getting-started') ?? visibleItems[0];
---

<MarketingLayout title={messages.indexTitle} description={messages.indexDescription} canonicalPath={learnIndexPath(locale)} locale={locale}>
  <main class="learn-hub">
    <section class="learn-hub-hero">
      <div class="learn-hub-grid" aria-hidden="true"></div>
      <div class="container learn-hub-hero-inner">
        <div class="learn-hub-copy">
          <p class="learn-hub-eyebrow"><Sparkles size={14} strokeWidth={2} /> {pageCopy.eyebrow}</p>
          <h1>{pageCopy.heroTitleStart}<br /><span>{pageCopy.heroTitleAccent}</span></h1>
          <p class="learn-hub-intro">{pageCopy.heroIntro}</p>
          <div class="learn-hub-actions">
            <a class="btn btn-primary learn-hub-primary" href={firstGuide ? learnPath(learnSlug(firstGuide.id), locale) : learnIndexPath(locale)}>
              {pageCopy.primaryAction}<ArrowRight size={16} aria-hidden="true" />
            </a>
            <a class="btn btn-outline learn-hub-secondary" href="#guide-catalog">
              {pageCopy.secondaryAction}<Compass size={16} aria-hidden="true" />
            </a>
          </div>
          <dl class="learn-hub-metrics">
            <div><dt>{visibleItems.length}</dt><dd>{pageCopy.guideMetric}</dd></div>
            <div><dt>{demoCount}</dt><dd>{pageCopy.demoMetric}</dd></div>
            <div><dt>{grouped.length}</dt><dd>{pageCopy.categoryMetric}</dd></div>
          </dl>
        </div>

        <aside class="curriculum-card" aria-label={pageCopy.curriculumTitle}>
          <div class="curriculum-head">
            <div><span class="curriculum-kicker">{pageCopy.curriculum}</span><strong>{pageCopy.curriculumTitle}</strong></div>
            <span class="curriculum-status"><span></span>{pageCopy.curriculumStatus}</span>
          </div>
          <ol class="curriculum-list">
            {grouped.map((group, index) => (
              <li>
                <a href={`#category-${group.category}`}>
                  <span class="curriculum-icon"><group.meta.icon size={17} strokeWidth={1.9} /></span>
                  <span class="curriculum-line" aria-hidden="true"></span>
                  <span class="curriculum-copy"><small>STEP {group.meta.number}</small><strong>{group.label}</strong></span>
                  <span class="curriculum-count">{group.items.length}</span>
                  {index === 0 ? <Play size={14} fill="currentColor" aria-hidden="true" /> : <ArrowRight size={14} aria-hidden="true" />}
                </a>
              </li>
            ))}
          </ol>
          <div class="curriculum-foot"><Check size={14} strokeWidth={2.4} aria-hidden="true" /><span>{locale === 'en' ? 'Every guide is reviewed against the current API.' : '모든 가이드는 현재 API를 기준으로 검토됩니다.'}</span></div>
        </aside>
      </div>
    </section>

    <nav class="learn-category-nav" aria-label={pageCopy.categoryJump}>
      <div class="container learn-category-nav-inner">
        {grouped.map(group => (
          <a href={`#category-${group.category}`}><group.meta.icon size={15} strokeWidth={1.9} /><span>{group.label}</span><small>{group.items.length}</small></a>
        ))}
      </div>
    </nav>

    <section class="container learning-paths" aria-labelledby="learning-paths-title">
      <div class="learn-section-heading">
        <div>
          <p>{pageCopy.pathsEyebrow}</p>
          <h2 id="learning-paths-title">{pageCopy.pathsTitle}</h2>
        </div>
        <p>{pageCopy.pathsIntro}</p>
      </div>

      <div class="learning-path-grid">
        {tracks.map((track, trackIndex) => (
          <article class:list={['learning-path-card', `learning-path-card--${trackIndex + 1}`]}>
            <div class="path-card-head"><span>{track.label}</span><strong>0{track.items.length}</strong></div>
            <div class="path-card-icon" aria-hidden="true">
              {trackIndex === 0 ? <Rocket size={23} /> : trackIndex === 1 ? <MousePointer2 size={23} /> : <Code2 size={23} />}
            </div>
            <h3>{track.title}</h3>
            <p>{track.description}</p>
            <ol>
              {track.items.map((item, index) => <li><span>{index + 1}</span>{item.data.title}</li>)}
            </ol>
            {track.items[0] && (
              <a href={learnPath(learnSlug(track.items[0].id), locale)}>{pageCopy.pathOpen}<ArrowRight size={15} aria-hidden="true" /></a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="guide-catalog" id="guide-catalog" aria-labelledby="guide-catalog-title">
      <div class="container">
        <div class="catalog-topline">
          <div class="learn-section-heading catalog-heading">
            <div>
              <p>{pageCopy.catalogEyebrow}</p>
              <h2 id="guide-catalog-title">{pageCopy.catalogTitle}</h2>
            </div>
            <p>{pageCopy.catalogIntro}</p>
          </div>

          <div class="catalog-search-wrap">
            <label for="learn-catalog-search">{pageCopy.searchLabel}</label>
            <div class="catalog-search">
              <Search size={19} strokeWidth={1.9} aria-hidden="true" />
              <input id="learn-catalog-search" type="search" placeholder={pageCopy.searchPlaceholder} autocomplete="off" data-learn-search />
              <kbd>/</kbd>
            </div>
            <div class="catalog-search-meta"><span>{pageCopy.searchHint}</span><strong data-result-count>{pageCopy.results(visibleItems.length)}</strong></div>
          </div>
        </div>

        <div class="catalog-groups">
          {grouped.map(group => (
            <section class="catalog-group" id={`category-${group.category}`} data-guide-group>
              <header class="catalog-group-head">
                <div class="catalog-group-index">{group.meta.number}</div>
                <div class="catalog-group-icon"><group.meta.icon size={21} strokeWidth={1.8} aria-hidden="true" /></div>
                <div><h3>{group.label}</h3><p>{group.meta.description}</p></div>
                <span>{messages.guideCount(group.items.length)}</span>
              </header>

              <div class="guide-card-grid">
                {group.items.map((item, itemIndex) => {
                  const slug = learnSlug(item.id);
                  const hasDemo = Boolean(item.data.demoId);
                  const hasStandaloneDemo = item.data.demoId === slug;
                  const searchText = [item.data.title, item.data.description, ...item.data.features].join(' ').toLocaleLowerCase(locale);
                  return (
                    <article class="guide-card" data-guide-card data-search={searchText}>
                      <div class="guide-card-top">
                        <span class="guide-number">{group.meta.number}.{String(itemIndex + 1).padStart(2, '0')}</span>
                        {hasDemo && <span class="guide-live"><span></span>{pageCopy.liveDemo}</span>}
                      </div>
                      <h4><a href={learnPath(slug, locale)}>{item.data.title}</a></h4>
                      <p>{item.data.description}</p>
                      <div class="guide-tags">
                        {item.data.features.slice(0, 4).map(feature => <span>{feature}</span>)}
                        {item.data.features.length > 4 && <span>+{item.data.features.length - 4}</span>}
                      </div>
                      <div class="guide-card-actions">
                        <a href={learnPath(slug, locale)}>{pageCopy.openGuide}<ArrowRight size={14} aria-hidden="true" /></a>
                        {hasStandaloneDemo && <a href={learnDemoPath(slug, locale)} target="_blank" rel="noopener noreferrer"><Play size={12} fill="currentColor" aria-hidden="true" />{pageCopy.openDemo}</a>}
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          ))}
        </div>

        <div class="catalog-empty" data-catalog-empty hidden>
          <BookOpen size={28} strokeWidth={1.6} aria-hidden="true" />
          <strong>{pageCopy.noResultsTitle}</strong>
          <p>{pageCopy.noResultsBody}</p>
        </div>
      </div>
    </section>
  </main>
</MarketingLayout>

<style>
  .learn-hub { overflow: clip; background: var(--site-page-bg); }
  .learn-hub-hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--site-border); background: radial-gradient(circle at 78% 12%, color-mix(in srgb, var(--site-accent) 18%, transparent), transparent 31%), linear-gradient(180deg, color-mix(in srgb, var(--site-accent-soft) 44%, var(--site-page-bg)) 0%, var(--site-page-bg) 92%); }
  .learn-hub-grid { position: absolute; inset: 0; opacity: .55; background-image: linear-gradient(color-mix(in srgb, var(--site-accent) 8%, transparent) 1px, transparent 1px), linear-gradient(90deg, color-mix(in srgb, var(--site-accent) 8%, transparent) 1px, transparent 1px); background-size: 48px 48px; mask-image: linear-gradient(to bottom, black, transparent 88%); }
  .learn-hub-hero-inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(390px, .74fr); gap: clamp(48px, 7vw, 112px); align-items: center; min-height: 650px; padding-top: 82px; padding-bottom: 84px; }
  .learn-hub-copy { max-width: 760px; }
  .learn-hub-eyebrow { display: flex; align-items: center; gap: 8px; margin: 0 0 24px; color: var(--site-accent-strong); font-size: 13px; font-weight: 850; letter-spacing: .13em; }
  .learn-hub-eyebrow :global(svg) { color: var(--site-accent); }
  .learn-hub h1 { margin: 0; color: var(--site-text-primary); font-size: clamp(48px, 5.4vw, 76px); font-weight: 880; letter-spacing: -.07em; line-height: 1.03; word-break: keep-all; }
  .learn-hub h1 span { background: linear-gradient(105deg, #315ee8 2%, #168bd6 58%, #00a6b2); background-clip: text; color: transparent; }
  .learn-hub-intro { max-width: 690px; margin: 28px 0 0; color: var(--site-text-secondary); font-size: 17px; line-height: 1.82; word-break: keep-all; }
  .learn-hub-actions { display: flex; flex-wrap: wrap; gap: 11px; margin-top: 34px; }
  .learn-hub-actions a { min-height: 46px; padding-inline: 18px; }
  .learn-hub-primary, .learn-hub-secondary { gap: 8px; }
  .learn-hub-metrics { display: flex; gap: 0; margin: 44px 0 0; }
  .learn-hub-metrics div { min-width: 122px; padding-right: 30px; }
  .learn-hub-metrics div + div { border-left: 1px solid var(--site-border); padding-left: 30px; }
  .learn-hub-metrics dt { color: var(--site-text-primary); font-family: var(--site-font-mono); font-size: 24px; font-weight: 820; letter-spacing: -.05em; }
  .learn-hub-metrics dd { margin: 5px 0 0; color: var(--site-text-muted); font-size: 13px; font-weight: 720; }
  .curriculum-card { position: relative; overflow: hidden; border: 1px solid color-mix(in srgb, var(--site-border-strong) 70%, transparent); border-radius: 24px; background: #101a2c; color: #f7faff; box-shadow: 0 38px 90px -50px rgba(8, 15, 30, .9); }
  .curriculum-card::before { position: absolute; top: -100px; right: -70px; width: 260px; height: 260px; border-radius: 50%; background: rgba(59, 130, 246, .16); content: ''; }
  .curriculum-head { position: relative; display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; padding: 24px 25px 20px; border-bottom: 1px solid rgba(148, 163, 184, .14); }
  .curriculum-head > div { display: grid; gap: 6px; }
  .curriculum-kicker { color: #7791b9; font-family: var(--site-font-mono); font-size: 13px; font-weight: 800; letter-spacing: .12em; }
  .curriculum-head strong { color: #f7faff; font-size: 14px; }
  .curriculum-status { display: flex; align-items: center; gap: 6px; border: 1px solid rgba(52, 211, 153, .18); border-radius: 999px; padding: 5px 8px; background: rgba(16, 185, 129, .08); color: #6ee7b7; font-size: 13px; font-weight: 760; white-space: nowrap; }
  .curriculum-status span { width: 6px; height: 6px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 3px rgba(52, 211, 153, .1); }
  .curriculum-list { position: relative; z-index: 1; list-style: none; margin: 0; padding: 11px 25px 13px; }
  .curriculum-list li { position: relative; }
  .curriculum-list a { display: grid; grid-template-columns: 38px 1fr auto 15px; gap: 12px; align-items: center; min-height: 68px; color: inherit; text-decoration: none; }
  .curriculum-list a:hover .curriculum-copy strong { color: #93c5fd; }
  .curriculum-list a > :global(svg) { color: #60708b; }
  .curriculum-list li:first-child a > :global(svg) { color: #60a5fa; }
  .curriculum-icon { display: grid; z-index: 1; width: 38px; height: 38px; place-items: center; border: 1px solid #33445f; border-radius: 11px; background: #162238; color: #8fa7c9; }
  .curriculum-list li:first-child .curriculum-icon { border-color: rgba(96, 165, 250, .35); background: rgba(37, 99, 235, .18); color: #93c5fd; }
  .curriculum-line { position: absolute; left: 18px; top: 52px; width: 1px; height: 32px; background: #2d3b52; }
  .curriculum-list li:last-child .curriculum-line { display: none; }
  .curriculum-copy { display: grid; gap: 3px; }
  .curriculum-copy small { color: #63738e; font-family: var(--site-font-mono); font-size: 13px; font-weight: 780; letter-spacing: .1em; }
  .curriculum-copy strong { color: #e6edf8; font-size: 13px; transition: color 150ms ease; }
  .curriculum-count { min-width: 25px; border-radius: 7px; padding: 4px 6px; background: #19263c; color: #8190a7; font-family: var(--site-font-mono); font-size: 13px; text-align: center; }
  .curriculum-foot { display: flex; align-items: center; gap: 8px; padding: 14px 25px; border-top: 1px solid rgba(148, 163, 184, .14); background: rgba(8, 15, 30, .25); color: #77879f; font-size: 13px; }
  .curriculum-foot :global(svg) { color: #34d399; }
  .learn-category-nav { position: sticky; top: 68px; z-index: 50; border-bottom: 1px solid var(--site-border); background: color-mix(in srgb, var(--site-page-bg) 91%, transparent); backdrop-filter: blur(16px) saturate(160%); }
  .learn-category-nav-inner { display: flex; justify-content: center; gap: 5px; overflow-x: auto; padding-top: 10px; padding-bottom: 10px; scrollbar-width: none; }
  .learn-category-nav-inner::-webkit-scrollbar { display: none; }
  .learn-category-nav a { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 7px; min-height: 36px; border: 1px solid transparent; border-radius: 999px; padding: 0 11px; color: var(--site-text-secondary); font-size: 13px; font-weight: 740; text-decoration: none; }
  .learn-category-nav a:hover { border-color: var(--site-border); background: var(--site-surface); color: var(--site-accent-strong); }
  .learn-category-nav small { display: grid; min-width: 19px; height: 19px; place-items: center; border-radius: 999px; background: var(--site-surface); color: var(--site-text-muted); font-family: var(--site-font-mono); font-size: 13px; }
  .learning-paths { padding-top: 112px; padding-bottom: 118px; }
