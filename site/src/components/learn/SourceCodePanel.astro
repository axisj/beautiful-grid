---
import { Code } from 'astro:components';
import { readFileSync } from 'node:fs';
import { isAbsolute, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { demoManifest } from '../../data/demoManifest';
import type { Locale } from '../../i18n';
import { learnMessages } from './learnLocale';

interface Props {
  locale: Locale;
  demoId: string;
}

const { locale, demoId } = Astro.props;
const messages = learnMessages[locale];
const manifestItem = demoManifest[demoId];
const repositoryRoot = fileURLToPath(new URL('../../../../', import.meta.url));

interface FileContent {
  fileName: string;
  sourcePath: string;
  code: string;
  lang: string;
}

const files: FileContent[] = [];

if (manifestItem && manifestItem.sourceFiles) {
  for (const f of manifestItem.sourceFiles) {
    const absoluteSourcePath = resolve(repositoryRoot, f);
    const relativeSourcePath = relative(repositoryRoot, absoluteSourcePath);
    const isInsideRepository = !relativeSourcePath.startsWith('..') && !isAbsolute(relativeSourcePath);
    let code: string = messages.sourceUnavailable;
    if (isInsideRepository) {
      try {
        code = readFileSync(absoluteSourcePath, 'utf8');
      } catch {
        // Keep the fallback text so a missing manifest entry remains visible.
      }
    }
    const ext = f.split('.').pop() || 'tsx';
    files.push({
      fileName: f.split('/').pop() || f,
      sourcePath: f,
      code,
      lang: ext === 'css' ? 'css' : 'tsx',
    });
  }
}

const githubBaseUrl = 'https://github.com/axisj/beautiful-grid/blob/master/';
---

{files.length > 0 && (
  <div
    class="learn-source-card"
    data-source-panel
    data-copy-default={messages.copy}
    data-copy-success={messages.copied}
    data-copy-failed={messages.copyFailed}
  >
    <div class="learn-source-header">
      <div class="learn-source-tabs" role="tablist" aria-label={messages.sourceTabs}>
        {files.map((file, idx) => (
          <button
            type="button"
            role="tab"
            class="learn-source-tab"
            id={`tab-${demoId}-${idx}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${demoId}-${idx}`}
            tabindex={idx === 0 ? 0 : -1}
            data-tab-index={idx}
          >
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span>{file.fileName}</span>
          </button>
        ))}
      </div>
      <div class="learn-source-actions">
        <button
          type="button"
          class="learn-source-btn copy-btn"
          data-copy-target=""
          title={messages.copyTitle}
          aria-label={messages.copyAria}
        >
          <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span class="copy-text" aria-live="polite">{messages.copy}</span>
        </button>
        <a
          href={`${githubBaseUrl}${files[0].sourcePath}`}
          target="_blank"
          rel="noopener noreferrer"
          class="learn-source-btn github-link"
          title={messages.githubTitle}
          aria-label={messages.githubAria}
        >
          <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
            <path d="M9 18c-4.51 2-5-2-7-2"/>
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </div>

    <div class="learn-source-body">
      {files.map((file, idx) => (
        <div
          role="tabpanel"
          id={`panel-${demoId}-${idx}`}
          aria-labelledby={`tab-${demoId}-${idx}`}
          hidden={idx !== 0}
          data-panel-index={idx}
          data-source-code={file.code}
          data-source-path={file.sourcePath}
        >
          <Code code={file.code} lang={file.lang as any} themes={{ light: 'github-light', dark: 'github-dark-high-contrast' }} defaultColor="light" />
        </div>
      ))}
    </div>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-source-panel]').forEach(panel => {
    const tabs = panel.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const tabpanels = panel.querySelectorAll<HTMLElement>('[role="tabpanel"]');
    const copyBtn = panel.querySelector<HTMLButtonElement>('.copy-btn');
    const copyText = panel.querySelector<HTMLElement>('.copy-text');
    const githubLink = panel.querySelector<HTMLAnchorElement>('.github-link');
    const githubBaseUrl = 'https://github.com/axisj/beautiful-grid/blob/master/';
    const copyDefault = panel.dataset.copyDefault || 'Copy';
    const copySuccess = panel.dataset.copySuccess || 'Copied!';
    const copyFailed = panel.dataset.copyFailed || 'Failed';

    let activeIndex = 0;

    function switchTab(index: number) {
      activeIndex = index;
      tabs.forEach((tab, i) => {
        const isSelected = i === index;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
      });

      tabpanels.forEach((p, i) => {
        p.hidden = i !== index;
        if (i === index && githubLink) {
          const sourcePath = p.getAttribute('data-source-path') || '';
          githubLink.href = `${githubBaseUrl}${sourcePath}`;
        }
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => switchTab(index));

      tab.addEventListener('keydown', e => {
        let newIndex = activeIndex;
        if (e.key === 'ArrowRight') {
          newIndex = (activeIndex + 1) % tabs.length;
          e.preventDefault();
        } else if (e.key === 'ArrowLeft') {
          newIndex = (activeIndex - 1 + tabs.length) % tabs.length;
          e.preventDefault();
        } else if (e.key === 'Home') {
          newIndex = 0;
          e.preventDefault();
        } else if (e.key === 'End') {
          newIndex = tabs.length - 1;
          e.preventDefault();
        }
        if (newIndex !== activeIndex) {
          switchTab(newIndex);
          tabs[newIndex].focus();
        }
      });
    });

    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        const activePanel = tabpanels[activeIndex];
        const code = activePanel?.getAttribute('data-source-code') || '';
        try {
          await navigator.clipboard.writeText(code);
          copyText.textContent = copySuccess;
          setTimeout(() => {
            copyText.textContent = copyDefault;
          }, 2000);
        } catch {
          copyText.textContent = copyFailed;
        }
      });
    }
  });
</script>
