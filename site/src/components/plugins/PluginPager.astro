---
import { getCollection } from 'astro:content';
import type { Locale } from '../../i18n';
import { learnSlug } from '../learn/learnLocale';
import { pluginLearnSlugs, pluginMessages, pluginPath } from './pluginLocale';

interface Props { locale: Locale; currentSlug: string; }
const { locale, currentSlug } = Astro.props;
const messages = pluginMessages[locale];
const allLearn = await getCollection('learn');
const items = pluginLearnSlugs.flatMap(slug => {
  const item = allLearn.find(entry => entry.data.locale === locale && learnSlug(entry.id) === slug && !entry.data.draft);
  return item ? [{ item, slug }] : [];
});
const currentIndex = items.findIndex(entry => entry.slug === currentSlug);
const previous = currentIndex > 0 ? items[currentIndex - 1] : null;
const next = currentIndex >= 0 && currentIndex < items.length - 1 ? items[currentIndex + 1] : null;
---

<nav aria-label={messages.pagination} class="learn-pager">
  {previous ? (
    <a href={pluginPath(previous.slug, locale)} class="pager-btn prev">
      <span class="pager-label">← {messages.previous}</span>
      <span class="pager-title">{previous.item.data.title}</span>
    </a>
  ) : <div class="pager-placeholder" />}
  {next && (
    <a href={pluginPath(next.slug, locale)} class="pager-btn next">
      <span class="pager-label">{messages.next} →</span>
      <span class="pager-title">{next.item.data.title}</span>
    </a>
  )}
</nav>

<style>
  .learn-pager { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--site-border); }
  .pager-btn { display: flex; flex: 1 1 0; max-width: 48%; flex-direction: column; padding: 1rem 1.25rem; border: 1px solid var(--site-border); border-radius: var(--site-radius-sm, 8px); background: var(--site-surface, #f7f9fc); text-decoration: none; transition: border-color .15s ease, transform .15s ease; }
  .pager-btn:hover { border-color: var(--site-accent); transform: translateY(-2px); text-decoration: none; }
  .pager-btn.next { align-items: flex-end; text-align: right; }
  .pager-label { margin-bottom: .375rem; color: var(--site-text-muted); font-size: .8125rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
  .pager-title { color: var(--site-text-primary); font-size: .9375rem; font-weight: 600; line-height: 1.4; }
  .pager-placeholder { flex: 1 1 0; }
</style>
