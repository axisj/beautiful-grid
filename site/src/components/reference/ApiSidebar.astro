---
import { apiReferenceGroups, apiTypeId } from '../../data/apiReference';
import { localeFromPath, localizePath } from '../../i18n';

const locale = localeFromPath(Astro.url.pathname);
const isEn = locale === 'en';
const groupLabels: Record<string, string> = {
  core: 'Core component types', data: 'Data and events', query: 'Sort, filter, and toolbox',
  selection: 'Selection and editing', layout: 'Layout and display', reorder: 'Reordering', pivot: 'Pivot',
};
---

<aside class="api-sidebar" aria-label={isEn ? 'TypeScript API menu' : 'TypeScript API 메뉴'} data-api-sidebar>
  <div class="sidebar-top-title">
    <a href={localizePath('/api/props', locale)} class="overview-link">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
        <path d="M6 6h10"/>
        <path d="M6 10h10"/>
      </svg>
      <span>TypeScript API</span>
    </a>
  </div>

  <div class="api-filter-container">
    <label class="api-filter-label" for="api-type-filter">{isEn ? 'Find a type' : '타입 찾기'}</label>
    <input id="api-type-filter" class="api-type-filter" type="search" placeholder={isEn ? 'e.g. BGridColumn' : '예: BGridColumn'} autocomplete="off" />
  </div>

  <nav class="api-type-nav">
    {apiReferenceGroups.map(group => (
      <div class="sidebar-section api-nav-group">
        <div class="sidebar-category-title">{isEn ? (groupLabels[group.id] ?? group.label) : group.label}</div>
        <ul class="sidebar-nav-list">
          {group.entries.map(entry => (
            <li data-api-nav-item data-api-name={entry.name.toLowerCase()}>
              <a href={`#${apiTypeId(entry.name)}`} class="sidebar-item-link api-item-link">
                <code class="sidebar-item-title-en">{entry.name}</code>
                <span class="api-kind-badge">{entry.kind}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script>
  const filter = document.querySelector<HTMLInputElement>('#api-type-filter');
  const items = document.querySelectorAll<HTMLElement>('[data-api-nav-item]');
  const groups = document.querySelectorAll<HTMLElement>('.api-nav-group');
  filter?.addEventListener('input', () => {
    const query = filter.value.trim().toLowerCase();
    items.forEach(item => {
      item.hidden = Boolean(query) && !item.dataset.apiName?.includes(query);
    });
    groups.forEach(group => {
      group.hidden = Boolean(query) && !group.querySelector('[data-api-nav-item]:not([hidden])');
    });
  });

  const updateActiveItem = () => {
    const hash = window.location.hash.slice(1);
    document.querySelectorAll<HTMLElement>('.api-item-link').forEach(link => {
      const href = link.getAttribute('href') || '';
      const isActive = hash && href === `#${hash}`;
      link.classList.toggle('active', Boolean(isActive));
    });
  };
  window.addEventListener('hashchange', updateActiveItem);
  updateActiveItem();
</script>
