---
import 'beautiful-grid/style.css';
import '../styles/globals.css';
import { localeMeta, normalizeLocale, type Locale } from '../i18n';
import { themeBootstrapScript } from '../i18n/theme';

interface Props {
  title: string;
  canonicalPath?: string;
  locale?: Locale;
}

const { title, canonicalPath, locale: localeProp = 'ko' } = Astro.props;
const locale = normalizeLocale(localeProp);
const canonicalUrl = canonicalPath ? new URL(canonicalPath, Astro.site || 'https://bgrid.axisj.com') : null;
---
<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3H72NFVZT7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3H72NFVZT7');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeBootstrapScript}></script>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" href="/favicon_dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple_touch_icon.png" />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <style>
      html, body {
        margin: 0;
        width: 100%;
        height: 100%;
        min-height: 100dvh;
        overflow: hidden;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        background-color: var(--site-page-bg);
        color: var(--site-text-primary);
      }
      html {
        padding: 0;
      }
      body.demo-only-body {
        box-sizing: border-box;
        padding: 16px !important;
      }
      main {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
      }
    </style>
  </head>
  <body class="demo-only-body">
    <main>
      <slot />
    </main>
  </body>
</html>
