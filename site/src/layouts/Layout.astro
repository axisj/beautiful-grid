---
import '../styles/globals.css';
import '../../../beautiful-grid/style.css';
import { localeAlternates, localeMeta, normalizeLocale, type Locale } from '../i18n';
import { themeBootstrapScript } from '../i18n/theme';
import SpeedInsights from '@vercel/speed-insights/astro';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  locale?: Locale;
  alternatePaths?: Partial<Record<Locale, string>>;
  noIndex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description = 'BeautifulGrid - A React DataGrid library for business applications.',
  canonicalPath = Astro.url.pathname,
  locale: localeProp = 'ko',
  alternatePaths,
  noIndex = false,
  ogImage,
  ogImageAlt = title,
} = Astro.props;

const locale = normalizeLocale(localeProp);
const defaultOgImage = locale === 'en' ? '/og-image-en.png' : '/og-image.png';
const finalOgImage = ogImage || defaultOgImage;
const siteUrl = Astro.site || new URL('https://bgrid.axisj.com');
const canonicalUrl = new URL(canonicalPath, siteUrl);
const inferredAlternates = localeAlternates(canonicalPath);
const koUrl = new URL(alternatePaths?.ko || inferredAlternates.ko, siteUrl);
const enUrl = new URL(alternatePaths?.en || inferredAlternates.en, siteUrl);
const ogImageUrl = finalOgImage ? new URL(finalOgImage, siteUrl) : null;
const normalizedCanonicalPath = canonicalPath.replace(/\/$/, '');
const markdownPath = /^\/(?:en\/)?learn\/[^/]+$/.test(normalizedCanonicalPath) ||
    /^\/(?:en\/)?api\/props$/.test(normalizedCanonicalPath)
  ? `${normalizedCanonicalPath}.md`
  : null;
const markdownUrl = markdownPath ? new URL(markdownPath, siteUrl) : null;
const llmsUrl = new URL('/llms.txt', siteUrl);
---
<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3H72NFVZT7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3H72NFVZT7');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={themeBootstrapScript}></script>
    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="icon" type="image/png" href="/favicon_dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple_touch_icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ko" href={koUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={koUrl} />
    <link rel="describedby" href={llmsUrl} type="text/plain" />
    {markdownUrl && <link rel="alternate" href={markdownUrl} type="text/markdown" />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:locale:alternate" content={localeMeta[locale === 'ko' ? 'en' : 'ko'].ogLocale} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:secure_url" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:type" content="image/png" />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={ogImageAlt} />}

    <!-- Social cards -->
    {ogImageUrl && <meta name="twitter:card" content="summary_large_image" />}
    {ogImageUrl && <meta name="twitter:title" content={title} />}
    {ogImageUrl && <meta name="twitter:description" content={description} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
  </head>
  <body>
    <slot />
    <SpeedInsights />
  </body>
</html>
