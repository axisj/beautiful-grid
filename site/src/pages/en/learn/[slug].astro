---
import { getCollection } from 'astro:content';
import LearnArticlePage from '../../../components/learn/LearnArticlePage.astro';
import { learnSlug } from '../../../components/learn/learnLocale';
import { isPluginLearnSlug } from '../../../components/plugins/pluginLocale';

export async function getStaticPaths() {
  const allLearn = await getCollection('learn');
  return allLearn
    .filter(item => item.data.locale === 'en' && item.id.startsWith('en/') && !item.data.draft && !isPluginLearnSlug(learnSlug(item.id)))
    .map(item => ({
      params: { slug: item.id.replace(/^en\//, '').replace(/\.(md|mdx)$/, '') },
      props: { item },
    }));
}

const { item } = Astro.props;
---

<LearnArticlePage locale="en" item={item} />
