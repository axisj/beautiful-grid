---
import { getCollection } from 'astro:content';
import LearnArticlePage from '../../../components/learn/LearnArticlePage.astro';

export async function getStaticPaths() {
  const allLearn = await getCollection('learn');
  return allLearn
    .filter(item => item.data.locale === 'en' && item.id.startsWith('en/') && !item.data.draft)
    .map(item => ({
      params: { slug: item.id.replace(/^en\//, '').replace(/\.(md|mdx)$/, '') },
      props: { item },
    }));
}

const { item } = Astro.props;
---

<LearnArticlePage locale="en" item={item} />
