---
import { getCollection } from 'astro:content';
import PluginArticlePage from '../../../components/plugins/PluginArticlePage.astro';
import { learnSlug } from '../../../components/learn/learnLocale';

const item = (await getCollection('learn')).find(entry => entry.data.locale === 'en' && learnSlug(entry.id) === 'editor-plugins');
if (!item) throw new Error('English plugin overview not found');
---
<PluginArticlePage locale="en" item={item} />
