  description={t('아름다운 기본 디자인과 편집, 정렬, 필터링, 선택, 병합, 집계, 피벗을 React에 자연스럽게 연결하는 Apache-2.0 오픈소스 Data Grid입니다.', 'An Apache-2.0 open-source React Data Grid with beautiful defaults and powerful editing, sorting, filtering, selection, merging, aggregation, and pivoting.')}
  canonicalPath={canonicalPath}
  locale={locale}
  ogImage="/og-image.png"
