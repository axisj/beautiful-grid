  .capability-item-fps button {
    display: flex;
    width: 100%;
    min-height: 38px;
    align-items: center;
    justify-content: space-between;
    gap: var(--home-space-3);
    margin-top: auto;
    border: 1px solid #dfe8f3;
    border-radius: 10px;
    padding: 8px 11px;
    background: #f8fbff;
    color: #1d5fd4;
