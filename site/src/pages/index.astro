---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import { getCollection } from 'astro:content';
import HomeHeroGrid from '../components/home/HomeHeroGrid';
import { productFacts } from '../data/productFacts';
import { bundleMetrics } from '../data/bundleMetrics';
import packageJson from '../../../package.json';
import { localizePath, normalizeLocale, type Locale } from '../i18n';

interface Props { locale?: Locale; }

const locale = normalizeLocale(Astro.props.locale);
const canonicalPath = localizePath('/', locale);

const englishCopy: Record<string, string> = {
  '대용량 탐색': 'Large-scale exploration',
  '55만 행도 필요한 만큼만 그려 빠르게 살펴봅니다.': 'Explore 550,000 rows while rendering only what the screen needs.',
  '가상 스크롤로 현재 보이는 행만 그리고, 고정 열로 기준 정보를 붙잡습니다. 화면 크기가 달라져도 넓고 긴 데이터를 끊김 없이 살펴볼 수 있습니다.': 'Virtual scrolling renders only visible rows while frozen columns keep reference data in view. Explore wide, long datasets smoothly across screen sizes.',
  '현재 화면에 필요한 셀만 렌더링': 'Render only the cells the viewport needs',
  '55만 행 예제': '550K-row example',
  '고정 열': 'Frozen columns',
  '리사이즈': 'Resize',
  '셀 편집': 'Cell editing',
  '셀에서 입력하고 저장한 뒤, 다음 칸으로 바로 이동합니다.': 'Edit and save in place, then move directly to the next cell.',
  '텍스트·체크박스·날짜·선택 입력기를 바로 쓰거나 Ant Design 구성 요소를 연결할 수 있습니다. 유효성 검사와 키보드 이동까지 한 흐름으로 이어집니다.': 'Use built-in text and checkbox editors, date and select plugins, or connect Ant Design components. Validation and keyboard movement stay in one flow.',
  '입력·검증·저장·이동을 한 번에 처리': 'Edit, validate, save, and move in one flow',
  '내장 편집기': 'Built-in editors',
  '에디터 플러그인': 'Editor plugins',
  '키보드 이동': 'Keyboard navigation',
  '조회와 선택': 'Query and selection',
  '정렬·필터로 찾고, 선택한 행을 다음 업무로 넘깁니다.': 'Find records with sort and filter, then pass selected rows into the next task.',
  '여러 조건으로 정렬하고 값·텍스트·숫자를 필터링합니다. 검색과 행 선택 결과는 화면 안에서 처리하거나 서버 조회 조건으로 그대로 넘길 수 있습니다.': 'Sort by multiple conditions and filter values, text, or numbers. Process search and selection locally or pass the query to a server.',
  '조회 조건과 선택 상태를 한곳에서 관리': 'Manage query and selection state together',
  '정렬·필터': 'Sorting & filtering',
  '검색': 'Search',
  '행 선택': 'Row selection',
  '구조화와 집계': 'Structure and aggregation',
  '반복 항목은 묶고, 숫자는 한눈에 읽히게 집계합니다.': 'Group repeated values and aggregate numbers into readable results.',
  '열 그룹과 셀 병합으로 구조를 드러내고, 요약 행과 피벗으로 필요한 수치를 모읍니다. 행·열 배치와 색상도 업무 기준에 맞게 조정할 수 있습니다.': 'Reveal structure with column groups and merged cells, then collect key figures with summary rows and pivots. Adjust layout and color to your workflow.',
  '업무 기준에 맞춘 묶음·집계·표현': 'Grouping, aggregation, and presentation for real work',
  '셀 병합': 'Cell merge',
  '55만 행 업무 데이터': '550K-row business dataset',
  '기본 행 높이를 유지한 채 첫 행부터 550,000번째 행까지 가상 스크롤로 탐색합니다.': 'Virtual-scroll from the first row to row 550,000 at the default row height.',
  '텍스트, Select, Date 입력과 저장·취소·이동 규칙을 셀 안에서 실행합니다.': 'Run text, Select, and Date editing with save, cancel, and move rules inside each cell.',
  'UI 연동': 'UI integration',
  'Ant Design 편집 플러그인': 'Ant Design editor plugins',
  'Select, TreeSelect, Cascader, DatePicker 등 기존 UI 체계를 편집기에 연결합니다.': 'Connect Select, TreeSelect, Cascader, DatePicker, and your existing UI system to cell editors.',
  '조회 조건': 'Query controls',
  '정렬·필터 툴박스': 'Sort & filter toolbox',
  '다중 정렬과 값·텍스트·숫자 필터를 제어형 query로 다룹니다.': 'Control multi-sort and value, text, and numeric filters through one query.',
  '병합 편집': 'Merged editing',
  '병합 셀 편집': 'Merged-cell editing',
  '병합된 범위의 변경을 하나의 트랜잭션으로 미리 보고 저장합니다.': 'Preview and save changes across a merged range as one transaction.',
  '집계': 'Aggregation',
  'Pivot과 Summary': 'Pivot and Summary',
  '반복되는 행을 그룹화하고 사용자 집계 결과를 읽기 좋은 구조로 만듭니다.': 'Group repeated rows and present custom aggregates in a readable structure.',
};

const t = (ko: string, en?: string) => locale === 'en' ? (en ?? englishCopy[ko] ?? ko) : ko;
const localize = <T,>(value: T): T => {
  if (typeof value === 'string') return t(value) as T;
  if (Array.isArray(value)) return value.map(localize) as T;
  if (value && typeof value === 'object') {
    return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, localize(entry)])) as T;
  }
  return value;
};

const liveExampleCount = (await getCollection('learn')).filter(
  (item) => item.data.locale === 'ko' && !item.data.draft && item.data.demoId,
).length;

const strengthStories = [
  {
    number: '01',
    kicker: '대용량 탐색',
