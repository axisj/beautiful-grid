  .strengths-section { background: #ffffff; }

  .strength-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--home-space-4);
  }

  .strength-card {
    position: relative;
    display: grid;
    min-height: 430px;
    overflow: hidden;
    border: 1px solid #dfe7f1;
    border-radius: 24px;
    padding: clamp(32px, 3.2vw, 40px);
    background: #fbfdff;
    box-shadow: 0 26px 56px -48px rgba(15, 23, 42, 0.54);
  }

  .strength-card:nth-child(1),
  .strength-card:nth-child(4) { grid-column: span 7; }
  .strength-card:nth-child(2),
  .strength-card:nth-child(3) { grid-column: span 5; }

  .strength-card-blue { --card-accent: #2563eb; --card-soft: #eaf2ff; }
  .strength-card-violet { --card-accent: #7c3aed; --card-soft: #f2edff; }
  .strength-card-cyan { --card-accent: #0284a8; --card-soft: #e6f8fb; }
  .strength-card-emerald { --card-accent: #059669; --card-soft: #e8f8f1; }

  .strength-card::after {
    position: absolute;
    inset: auto -100px -160px auto;
