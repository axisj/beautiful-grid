  .section-heading h2,
  .performance-copy h2,
  .quick-start-intro h2,
  .decision-copy h2,
  .final-cta h2 {
    margin: 12px 0 0;
    color: #0f172a;
    font-size: clamp(36px, 4.3vw, 54px);
    font-weight: 850;
    letter-spacing: -0.018em;
    line-height: 1.16;
    word-break: keep-all;
