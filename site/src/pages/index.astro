<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-command]');
  copyButton?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('npm i beautiful-grid');
      const previousLabel = copyButton.textContent;
      copyButton.textContent = copyButton.dataset.copySuccess ?? 'Copied';
      window.setTimeout(() => { copyButton.textContent = previousLabel; }, 1400);
    } catch {
      copyButton.textContent = 'npm i beautiful-grid';
    }
  });

  const fpsCard = document.querySelector<HTMLElement>('[data-fps-card]');
  const fpsButton = fpsCard?.querySelector<HTMLButtonElement>('[data-fps-measure]');
  const fpsValue = fpsCard?.querySelector<HTMLElement>('[data-fps-value]');
  const mountValue = fpsCard?.querySelector<HTMLElement>('[data-mount-value]');
  const fpsDetail = fpsCard?.querySelector<HTMLElement>('[data-fps-detail]');
  const heroGridStage = document.querySelector<HTMLElement>('.hero-grid-stage');
  const heroGridLoading = heroGridStage?.querySelector<HTMLElement>('[data-hero-grid-loading]');

  const markHeroGridReady = () => {
    heroGridStage?.classList.add('is-ready');
    heroGridLoading?.setAttribute('aria-hidden', 'true');
  };

  const updateMountValue = (duration: number) => {
    if (mountValue) mountValue.textContent = duration.toFixed(1);
  };

  const storedMountDuration = Number(document.documentElement.dataset.bgridHomeGridMountMs);
  if (Number.isFinite(storedMountDuration) && storedMountDuration > 0) {
    updateMountValue(storedMountDuration);
    markHeroGridReady();
  }

  window.addEventListener('bgrid-home-grid-mounted', ((event: CustomEvent<{ duration: number }>) => {
    updateMountValue(event.detail.duration);
    markHeroGridReady();
  }) as EventListener);

  fpsButton?.addEventListener('click', () => {
    const scroller = document.querySelector<HTMLElement>('.hero-grid-stage .bgrid-scroll-container');
    if (!scroller || !fpsValue || !fpsDetail || !fpsCard) return;

    const duration = 2200;
    const maximumScrollTop = Math.max(scroller.scrollHeight - scroller.clientHeight, 0);
    const originalScrollTop = scroller.scrollTop;
    const frameTimes: number[] = [];
    let startedAt: number | undefined;

    fpsButton.disabled = true;
    fpsButton.textContent = fpsButton.dataset.measureRunning ?? 'Measuring';
    fpsDetail.textContent = fpsButton.dataset.measureProgress ?? 'Scrolling the same range down and back.';

    const measureFrame = (now: number) => {
      startedAt ??= now;
      frameTimes.push(now);

      const elapsed = now - startedAt;
      const progress = Math.min(elapsed / duration, 1);
      const scrollProgress = progress <= 0.5 ? progress * 2 : (1 - progress) * 2;
      scroller.scrollTo({ top: maximumScrollTop * scrollProgress, behavior: 'auto' });

      if (elapsed < duration) {
        window.requestAnimationFrame(measureFrame);
        return;
      }

      const measuredDuration = frameTimes.at(-1)! - frameTimes[0];
      const fps = Math.round((frameTimes.length - 1) / (measuredDuration / 1000));
      const frameGaps = frameTimes.slice(1).map((time, index) => time - frameTimes[index]).sort((a, b) => a - b);
      const p95FrameTime = frameGaps[Math.floor(frameGaps.length * 0.95)] ?? 0;

      scroller.scrollTo({ top: originalScrollTop, behavior: 'auto' });
      fpsValue.textContent = String(fps);
      fpsDetail.textContent = `${fpsButton.dataset.detailPrefix ?? 'Chromium · 72 rows · scroll p95'} ${p95FrameTime.toFixed(1)}ms · ${fpsButton.dataset.detailMount ?? 'mount'} ${mountValue?.textContent ?? '--'}ms`;
      fpsButton.innerHTML = `<span>${fpsButton.dataset.measureReady ?? 'Test in my browser'}</span><i aria-hidden="true">↗</i>`;
      fpsButton.disabled = false;
      fpsCard.classList.add('is-measured');
    };

    window.requestAnimationFrame(measureFrame);
  });

</script>

