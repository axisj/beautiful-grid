    letter-spacing: -.04em;
    line-height: 1.1;
  }

  .capability-item-primary > span,
  .capability-item-bundle > span,
  .capability-item-feature > span { margin-top: auto; padding-top: var(--home-space-4); }

  .feature-tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: var(--home-space-4);
    border-top: 1px solid #e8edf4;
    padding-top: var(--home-space-4);
  }

  .feature-tags > span {
    border: 1px solid #e4e8f3;
    border-radius: 9px;
    padding: 8px 9px;
    background: rgba(248, 247, 255, 0.86);
