  .hero-visual {
    position: relative;
    width: 100%;
    margin-top: var(--home-space-9);
    container-type: inline-size;
  }

  .hero-grid-stage {
    position: relative;
    display: grid;
    overflow: hidden;
    background: #ffffff;
  }

  .hero-grid-stage > :global(astro-island),
  .hero-grid-stage :global(.hero-grid-demo),
  .hero-grid-loading {
    min-width: 0;
    grid-area: 1 / 1;
  }

  .hero-grid-loading {
    position: relative;
    z-index: 2;
    display: grid;
    height: 520px;
    grid-template-rows: 42px minmax(0, 1fr) 34px;
    overflow: hidden;
    background: #ffffff;
    opacity: 1;
    transition: opacity 180ms ease, visibility 180ms ease;
  }

  .hero-grid-stage.is-ready .hero-grid-loading {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  .hero-grid-loading-head {
    display: grid;
    grid-template-columns: 46px 0.8fr 1.1fr 1.25fr 0.75fr 0.9fr;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid #e3eaf3;
    padding: 0 18px;
    background: #f7f9fc;
  }

  .hero-grid-loading-head span,
  .hero-grid-loading-foot span {
    height: 8px;
    border-radius: 999px;
    background: #e5ebf3;
  }

  .hero-grid-loading-head span:first-child { width: 18px; justify-self: center; }
  .hero-grid-loading-head span:nth-child(4) { width: 72%; }
  .hero-grid-loading-head span:nth-child(5) { width: 58%; }

  .hero-grid-loading-body {
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: #ffffff;
    background-image:
      linear-gradient(90deg, transparent 0 46px, rgba(226, 232, 240, 0.72) 46px 47px, transparent 47px),
      repeating-linear-gradient(180deg, transparent 0 28px, rgba(226, 232, 240, 0.72) 28px 29px);
  }

  .hero-grid-loading-body::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 26%, rgba(241, 245, 249, 0.82) 46%, transparent 66%);
    content: '';
    transform: translateX(-100%);
    animation: hero-grid-loading-shimmer 1.5s ease-in-out infinite;
  }

  .hero-grid-loading-status {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border-radius: 999px;
    padding: 9px 14px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 12px 32px -20px rgba(15, 23, 42, 0.45);
    color: #5f7088;
    font-size: 13px;
    font-weight: 760;
  }

  .hero-grid-loading-status i {
    width: 13px;
    height: 13px;
    border: 2px solid #c9d8ee;
    border-top-color: #2563eb;
    border-radius: 50%;
    animation: hero-grid-loading-spin 720ms linear infinite;
  }

  .hero-grid-loading-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #e3eaf3;
    padding: 0 18px;
    background: #f9fbfd;
  }

  .hero-grid-loading-foot span:first-child { width: 88px; }
  .hero-grid-loading-foot span:last-child { width: 54px; }

  @keyframes hero-grid-loading-shimmer {
    to { transform: translateX(100%); }
  }

  @keyframes hero-grid-loading-spin {
    to { transform: rotate(360deg); }
  }

  @container (max-width: 999px) {
    .hero-grid-loading { height: 420px; }
  }

  @container (max-width: 719px) {
    .hero-grid-loading { height: 340px; }
  }

  @container (max-width: 519px) {
    .hero-grid-loading { height: 280px; }
  }

  .capability-rail {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1.1fr;
    gap: var(--home-space-4);
    width: 100%;
    max-width: 108rem;
    margin-top: var(--home-space-9);
    padding-inline: clamp(16px, 2.5vw, 40px);
