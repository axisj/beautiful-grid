      radial-gradient(circle at 92% 8%, rgba(5, 150, 105, 0.09), transparent 40%),
      rgba(255, 255, 255, 0.9);
  }

  .capability-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-top: var(--home-space-4);
    border-top: 1px solid #e8edf4;
    padding-top: var(--home-space-4);
