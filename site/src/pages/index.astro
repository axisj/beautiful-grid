    color: #2563eb;
    font-family: var(--site-font-mono);
    font-weight: 850;
  }

  .copy-command {
    min-width: 58px;
    border: 0;
    border-radius: 8px;
    padding: var(--home-space-2) var(--home-space-3);
    background: #edf4ff;
    color: #1d4ed8;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 850;
  }

  .hero-trust-note {
    display: flex;
    align-items: center;
    gap: var(--home-space-2);
    margin: var(--home-space-4) 0 0;
    color: #718097;
    font-size: 13px;
    font-weight: 620;
