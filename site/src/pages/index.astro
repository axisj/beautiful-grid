    font-size: 13px;
    font-weight: 800;
    text-align: left;
  }

  .capability-item-fps button i { font-style: normal; font-size: 13px; transition: transform 150ms ease; }

  .capability-item-fps button:hover { border-color: #a9c7f4; background: #edf5ff; }
  .capability-item-fps button:hover i { transform: translate(2px, -2px); }
  .capability-item-fps button:disabled { cursor: wait; opacity: 0.62; }

  .capability-item-fps.is-measured {
