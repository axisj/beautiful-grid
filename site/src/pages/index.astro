  .strength-meta {
    display: flex;
    align-items: center;
    gap: var(--home-space-2);
    color: var(--card-accent);
    font-family: var(--site-font-mono);
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 0.12em;
