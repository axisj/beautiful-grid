const t = (ko: string, en?: string) => locale === 'en' ? (en ?? englishCopy[ko] ?? ko) : ko;
const localize = <T,>(value: T): T => {
  if (typeof value === 'string') return t(value) as T;
  if (Array.isArray(value)) return value.map(localize) as T;
  if (value && typeof value === 'object') {
    return Object.fromEntries(Object.entries(value).map(([key, entry]) => [key, localize(entry)])) as T;
  }
  return value;
};

